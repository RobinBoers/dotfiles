{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 9007199254740991,
  "permissions": {
    "ask": [
      "Edit",
      "Write",
      "NotebookEdit"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/bin/claude-notify"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/bin/claude-statusline",
    "padding": 0
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-code-plugins": true,
    "code-review@claude-code-plugins": true
  },
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "autoConnectIde": true,
  "defaultMode": "manual",
  "feedbackDrafts": "off"
}
