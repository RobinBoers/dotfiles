{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 9007199254740991,
  "permissions": {
    "ask": [
      "Edit",
      "Write",
      "NotebookEdit"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/etc/claude/hooks/notify"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/etc/claude/hooks/notify"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/etc/claude/hooks/worktree create"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/etc/claude/hooks/worktree remove"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/etc/claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "pr-review-toolkit@claude-code-plugins": true,
    "code-review@claude-code-plugins": true,
    "swift-lsp@claude-plugins-official": true
  },
  "feedbackDrafts": "off",
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "stable",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "autoConnectIde": true,
  "defaultMode": "manual"
}
