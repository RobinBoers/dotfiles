#!/usr/bin/env bash
# Portable 'realpath' utility with a --relative-to option.

set -eu

source arg

usage() {
  echo "Usage: $(basename "$0") [opts] [path]..."
  echo
  echo "OPTIONS"
  echo "  -s, --strip        Don't expand symlinks"
  echo "  -z, --zero         End each output line with NUL, not newline"
  echo "  -q, --quiet        Suppress warnings if resolving fails"
  echo "  --relative-to=DIR  Print the resolved path relative to DIR"
  echo
  exit 0
}

arg --define strip --short s --flag
arg --define zero --short z --flag
arg --define quiet --short q --flag
arg --define relative-to --default ''
arg --define help --short h --flag
arg --parse "$@"

[ "$help" = 0 ] || usage
[ "$argc" -gt 0 ] || argv=(.)

normalize() {
  IFS=/ read -ra parts <<< "$1"
  out=()

  for part in "${parts[@]}"; do
    case $part in
      ''|.) ;;
      ..) [ "${#out[@]}" -eq 0 ] || unset 'out[-1]' ;;
      *) out+=("$part") ;;
    esac
  done

  (IFS=/; printf '/%s\n' "${out[*]}")
}

resolve() {
  if [ ! -e "$1" ] && [ ! -L "$1" ]; then
    [ "$quiet" = 1 ] || err "'$1': No such file or directory"
    exit 1
  fi

  if [ "$strip" = 1 ]; then
    case $1 in
      /*) normalize "$1" ;;
      *) normalize "$PWD/$1" ;;
    esac
  elif readlink -f "$1" 2>/dev/null; then
    :
  else
    # Fallback for macOS/BSDm, where readlink -f is unavailable.
    (cd "$(dirname "$1")" && echo "$(pwd -P)/$(basename "$1")")
  fi
}

relative() {
  common=$1
  up=

  while [ "$2" != "$common" ] && [[ $2 != "${common%/}"/* ]]; do
    common=${common%/*}
    common=${common:-/}
    up+=../
  done

  rest=${2#"$common"}
  rest=$up${rest#/}
  rest=${rest%/}

  printf '%s\n' "${rest:-.}"
}

[ -z "$relative_to" ] || base=$(resolve "$relative_to")

for target in "${argv[@]}"; do
  path=$(resolve "$target")
  [ -z "$relative_to" ] || path=$(relative "$base" "$path")

  if [ "$zero" = 1 ]; then
    printf '%s\0' "$path"
  else
    printf '%s\n' "$path"
  fi
done
