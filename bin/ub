#!/usr/bin/env bash
# Agent-friendly literature research CLI.

set -euo pipefail

source arg

required curl
required jq
required sqlite3
required node
required pdftotext
required unzip

: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"

: "${UB_EMAIL:=ub@geheimesite.nl}"
: "${UB_LITERATURE:=$XDG_DATA_HOME/ub/literature}"
: "${UB_EXTRACTIONS:=$XDG_CACHE_HOME/ub/extractions}"

: "${UB_FORMAT:=pretty}"

DATA=$XDG_DATA_HOME/ub
CACHE=$XDG_CACHE_HOME/ub

LIBRARY_DB=$DATA/library.db
HTTP_DB=$CACHE/http.db

usage() {
  echo "Usage: $(basename "$0") <subcommand> <args> [opts]"
  echo
  echo "GLOBAL OPTIONS"
  echo "  -h, --help                Show this help."
  echo "  --format <pretty|json>    Select output format."
  echo
  echo "SUBCOMMANDS"
  echo "  pull                      Download or refresh local research datasets."
  echo "  search <query>            Search OpenAlex, CORE, and ERIC for papers."
  echo "  inspect <doi|url>         Find research evidence and metadata for a specific paper."
  echo "  recurse <doi|url>         Traverse citations and references to find related papers."
  echo "  download <doi|url         Download a publicly available paper to library."
  echo "  import <doi|url> <path>   Import a manually downloaded paper to library."
  echo "  library                   List works in local library."
  echo "  view <doi|url>            View or extract a paper from local library."
  echo
  echo "SEARCH OPTIONS"
  echo "  --source <sources>        Comma-separated list of sources (openalex, core, eric)."
  echo "  --limit <n>               Limit number of search results."
  echo
  echo "RECURSE OPTIONS"
  echo "  --depth <n>               Set traversal depth."
  echo "  --direction <direction>   Traverse citations, references, or both."
  echo "  --limit <n>               Limit number of discovered nodes."
  echo
  echo "IMPORT OPTIONS"
  echo "  --move                    Move paper instead of copying it."
  echo
  echo "LIBRARY OPTIONS"
  echo "  -A, --all                 Include papers without downloads."
  echo
  echo "VIEW OPTIONS"
  echo "  --open                    Open the paper using OS-specified default app."
  echo "  --extract                 Extract text and structure from the paper."
  echo
  exit 0
}

# Helpers

query() { command sqlite3 -separator '|' -cmd '.timeout 5000' -cmd 'PRAGMA foreign_keys=ON;' "$@"; }
escape() { printf '%s' "$1" | sed "s/'/''/g"; }

modified_at() {
  swallow date -r "$1" +%s ||
    swallow stat -c %Y "$1" ||
    echo '0'
}

valid_pdf() {
  [ -s "$1" ] && [ "$(swallow dd if="$1" bs=5 count=1)" = '%PDF-' ]
}

# Cleanup

cleanup_paths=()
cleanup_owners=()

cleanup() {
  status=$?
  set +e

  for index in "${!cleanup_paths[@]}"; do
    if [ "${cleanup_owners[index]}" = "$BASHPID" ]; then
      rm -rf -- "${cleanup_paths[index]}"
    fi
  done

  return "$status"
}

defer() {
  cleanup_paths+=("$1")
  cleanup_owners+=("$BASHPID")
  trap cleanup EXIT
}

trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 131' QUIT
trap 'exit 143' TERM

# Setup

initialize() {
  mkdir -p "$DATA"
  mkdir -p "$CACHE"
  mkdir -p "$UB_LITERATURE"
  mkdir -p "$UB_EXTRACTIONS"

  query "$LIBRARY_DB" <<-SQL | quiet cat
    PRAGMA journal_mode=WAL;
    PRAGMA foreign_keys=ON;

    CREATE TABLE IF NOT EXISTS works (
      key TEXT PRIMARY KEY,
      doi TEXT,
      canonical_url TEXT,
      metadata TEXT NOT NULL DEFAULT '{}',
      updated_at INTEGER NOT NULL
    );

    CREATE TABLE IF NOT EXISTS aliases (
      alias TEXT PRIMARY KEY,
      work_key TEXT NOT NULL REFERENCES works(key) ON DELETE CASCADE
    );

    CREATE TABLE IF NOT EXISTS provider_ids (
      provider TEXT NOT NULL,
      provider_id TEXT NOT NULL,
      work_key TEXT NOT NULL REFERENCES works(key) ON DELETE CASCADE,
      PRIMARY KEY(provider, provider_id)
    );

    CREATE TABLE IF NOT EXISTS versions (
      work_key TEXT NOT NULL REFERENCES works(key) ON DELETE CASCADE,
      version TEXT NOT NULL,
      url TEXT NOT NULL,
      metadata TEXT NOT NULL DEFAULT '{}',
      PRIMARY KEY(work_key, url)
    );

    CREATE TABLE IF NOT EXISTS files (
      work_key TEXT NOT NULL REFERENCES works(key) ON DELETE CASCADE,
      version TEXT NOT NULL,
      path TEXT NOT NULL,
      sha256 TEXT NOT NULL,
      source_url TEXT,
      created_at INTEGER NOT NULL,
      PRIMARY KEY(work_key, version)
    );

    CREATE TABLE IF NOT EXISTS extractions (
      work_key TEXT PRIMARY KEY REFERENCES works(key) ON DELETE CASCADE,
      source_sha256 TEXT NOT NULL,
      text_path TEXT NOT NULL,
      structured_path TEXT,
      sections TEXT,
      updated_at INTEGER NOT NULL
    );

	SQL

  query "$HTTP_DB" <<-SQL | quiet cat
    PRAGMA journal_mode=WAL;

    CREATE TABLE IF NOT EXISTS responses (
      provider TEXT NOT NULL,
      cache_key TEXT NOT NULL,
      url TEXT NOT NULL,
      status INTEGER NOT NULL,
      body BLOB,
      fetched_at INTEGER NOT NULL,
      expires_at INTEGER NOT NULL,
      PRIMARY KEY(provider, cache_key)
    );

    CREATE TABLE IF NOT EXISTS rate_limits (
      provider TEXT PRIMARY KEY,
      requested_at INTEGER NOT NULL DEFAULT 0,
      blocked_until INTEGER NOT NULL DEFAULT 0
    );

    CREATE TABLE IF NOT EXISTS retractions (
      original_doi TEXT PRIMARY KEY,
      notice_doi TEXT, nature TEXT
    );

    CREATE TABLE IF NOT EXISTS cache_state (
      key TEXT PRIMARY KEY,
      value TEXT NOT NULL
    );
	SQL
}

# Library functions

http() {
  provider=$1 ttl=$2 url=$3

  key=$(digest "$url")
  now=$(date +%s)

  row=$(query "$HTTP_DB" "SELECT fetched_at, expires_at, status FROM responses
    WHERE provider='$(escape "$provider")' AND cache_key='$key';")

  if [ -n "$row" ]; then
    IFS='|' read -r fetched expires status <<<"$row"

    if [ "$expires" -gt "$now" ]; then
      query "$HTTP_DB" "SELECT CAST(body AS TEXT)
        FROM responses WHERE provider='$(escape "$provider")' AND cache_key='$key';"

      return $((status < 200 || status >= 300))
    fi

    stale=$((status >= 200 && status < 300))
  else
    stale=0
  fi

  lock=$CACHE/lock-$provider
  spins=0

  while ! quiet mkdir "$lock"; do
    sleep .1
    spins=$((spins + 1))

    if [ "$spins" -ge 300 ]; then
      warn "$provider: request lock timed out"
      return 1
    fi
  done

  defer "$lock"

  now=$(date +%s)
  row=$(query "$HTTP_DB" "SELECT requested_at,blocked_until FROM rate_limits
    WHERE provider='$(escape "$provider")';")

  last=0
  blocked=0

  if [ -n "$row" ]; then
    IFS='|' read -r last blocked <<<"$row"
  fi

  if [ "$blocked" -gt "$now" ]; then
    sleep $((blocked - now))
  fi

  case "$provider" in
    core) delay=1000 ;;
    eric|opencitations) delay=500 ;;
    *) delay=120 ;;
  esac

  wait_ms=$((delay - (now - last) * 1000))

  if [ "$wait_ms" -gt 0 ]; then
    sleep "$((wait_ms / 1000)).$(printf '%03d' "$((wait_ms % 1000))")"
  fi

  response=$(mktemp "$CACHE/http.XXXXXX")
  defer "$response"
  headers=$response.headers
  defer "$headers"

  for attempt in 0 1 2; do
    now=$(date +%s)

    query "$HTTP_DB" "INSERT INTO rate_limits(provider,requested_at,blocked_until)
      VALUES('$(escape "$provider")',$now,0) ON CONFLICT(provider) DO UPDATE SET requested_at=$now;"

    code=$(curl -L \
      --connect-timeout 10 \
      --max-time 30 \
      -sS -D "$headers" \
      -o "$response" \
      -w '%{http_code}' \
      -H "User-Agent: ub/1.0 ($UB_EMAIL)" \
      -H 'Accept: application/json, text/html;q=0.9, */*;q=0.8' \
      "${@:4}" "$url") || code=000

    case "$code" in
      429|500|502|503|504|000)
        retry=$(grep -im1 '^retry-after:' "$headers" | cut -d: -f2- | xargs) || true
        case "${retry:-}" in ''|*[!0-9]*) retry=$((2 ** attempt)) ;; esac

        if [ "$code" = 429 ]; then
          query "$HTTP_DB" "UPDATE rate_limits SET blocked_until=$(($(date +%s) + retry))
            WHERE provider='$(escape "$provider")';"
        fi

        if [ "$attempt" -lt 2 ]; then
          sleep "$retry"
        fi
        ;;
      *) break ;;
    esac
  done

  now=$(date +%s)
  remaining=$(grep -Eim1 '^x-rate-?limit-remaining:' "$headers" | cut -d: -f2- | xargs) || true

  if [ "${remaining:-}" = 0 ]; then
    reset_at=$(grep -Eim1 '^x-rate-?limit-reset:' "$headers" | cut -d: -f2- | xargs) || true
    case "${reset_at:-}" in ''|*[!0-9]*) reset_at=$((now + 1)) ;; esac

    if [ "$reset_at" -lt "$now" ]; then
      reset_at=$((now + reset_at))
    fi

    query "$HTTP_DB" "UPDATE rate_limits SET blocked_until=$reset_at
      WHERE provider='$(escape "$provider")';"
  fi

  if swallow [ "$code" -ge 200 ] && [ "$code" -lt 300 ]; then
    query "$HTTP_DB" "INSERT INTO responses(
      provider,
      cache_key,
      url,
      status,
      body,
      fetched_at,
      expires_at
    ) VALUES(
      '$(escape "$provider")',
      '$key','$(escape "$url")',
      $code,
      readfile('$(escape "$response")'),
      $now,
      $((now + ttl))
    ) ON CONFLICT(provider,cache_key) DO UPDATE SET
      url=excluded.url,
      status=excluded.status,
      body=excluded.body,
      fetched_at=excluded.fetched_at,
      expires_at=excluded.expires_at;"

    cat "$response"
    return 0
  fi

  if [ "$stale" -eq 1 ]; then
    warn "$provider: refresh failed (HTTP $code). serving stale data"

    query "$HTTP_DB" "SELECT CAST(body AS TEXT) FROM responses
      WHERE provider='$(escape "$provider")' AND cache_key='$key';"

    return 0
  fi

  query "$HTTP_DB" "INSERT INTO responses(
    provider,
    cache_key,
    url,
    status,
    body,
    fetched_at,
    expires_at
  ) VALUES(
    '$(escape "$provider")',
    '$key',
    '$(escape "$url")',
    ${code:-0},
    NULL,
    $now,
    $((now + 300))
  ) ON CONFLICT(provider,cache_key) DO UPDATE SET
    status=excluded.status,
    body=NULL,
    fetched_at=excluded.fetched_at,
    expires_at=excluded.expires_at;"

  warn "$provider: request failed (HTTP $code)"
  return 1
}

identifier() {
  input=${1#doi:}

  doi=$(extract_doi "$input" || find_doi "$input")

  if [ -n "$doi" ]; then
    doi=$(lower "$doi" | trim)
    url=https://doi.org/$doi
    key=doi-$doi
  else
    url="$input"
    key=url-$(digest "$url" | cut -c1-12)
  fi

  jq -nc \
    --arg id "$key" \
    --arg url "$url" \
    --arg doi "${doi:-}" \
    '{id:$id,url:$url}+if $doi!="" then {doi:$doi} else {} end'
}

extract_doi() {
  echo "$1" |
    grep -Eio '10\.[0-9]{4,9}/[-._;()/:a-z0-9]+' |
    head -n 1 |
    sed 's/[.,;:]*$//'
}

find_doi() {
  body=$(http identifier 604800 "$1") || return
  extract_doi "$body"
}

# Commands

pull() {
  if [ "$#" -gt 0 ]; then
    err "pull: unexpected argument '$1'"
  fi

  initialize

  pull_retractions
  pull_replications
}

: "${UB_RETRACTIONS_UPSTREAM:=https://api.labs.crossref.org/data/retractionwatch}"
: "${UB_RETRACTIONS_LOCAL:=$XDG_CACHE_HOME/ub/retraction-watch.csv}"

pull_retractions() {
  tmp=$UB_RETRACTIONS_LOCAL.tmp.$$
  defer "$tmp"

  if ! curl -L --connect-timeout 10 --max-time 600 -fsS "$UB_RETRACTIONS_UPSTREAM" -o "$tmp"; then
    err "retraction watch: pull failed"
  fi

  if ! mv "$tmp" "$UB_RETRACTIONS_LOCAL"; then
    err "retraction watch: install failed"
  fi

  index_retractions
}

index_retractions() {
  modified=$(modified_at "$UB_RETRACTIONS_LOCAL")
  indexed=$(query "$HTTP_DB" "SELECT value FROM cache_state WHERE key='retraction_watch_mtime';")

  if [ "$modified" = "$indexed" ]; then
    return
  fi

  query "$HTTP_DB" <<-SQL
    DROP TABLE IF EXISTS rw_import;
    .import --csv '$UB_RETRACTIONS_LOCAL' rw_import
    BEGIN;
    DELETE FROM retractions;
    INSERT OR REPLACE INTO retractions(original_doi,notice_doi,nature)
      SELECT lower("OriginalPaperDOI"),lower("RetractionDOI"),"RetractionNature" FROM rw_import WHERE "OriginalPaperDOI"!='';
    INSERT OR REPLACE INTO cache_state(key,value) VALUES('retraction_watch_mtime','$modified');
    DROP TABLE rw_import;
    COMMIT;
	SQL
}

: "${UB_REPLICATIONS_UPSTREAM:=https://osf.io/2tbvd/download}"
: "${UB_REPLICATIONS_LOCAL:=$XDG_CACHE_HOME/ub/fred.xlsx}"

pull_replications() {
  tmp=$UB_REPLICATIONS_LOCAL.tmp.$$
  defer "$tmp"

  if ! curl -L --connect-timeout 10 --max-time 120 -fsS "$UB_REPLICATIONS_UPSTREAM" -o "$tmp"; then
    err "fred: pull failed"
  fi

  if ! mv "$tmp" "$UB_REPLICATIONS_LOCAL"; then
    err "fred: install failed"
  fi
}

search() {
  arg --define limit --default 20
  arg --define source --default openalex,core,eric
  arg --define format --default "$UB_FORMAT"

  arg --parse "$@"

  if [ "${#argv[@]}" -eq 0 ]; then
    err 'missing query'
  fi

  query="${argv[*]}"

  case "$limit" in
    ''|*[!0-9]*) err 'limit must be a positive integer' ;;
  esac

  if [ "$limit" -le 0 ]; then
    err 'limit must be a positive integer'
  fi

  case "$format" in
    pretty|json) ;;
    *) err "unknown output format '$format'" ;;
  esac

  case "$source" in
    ''|,*|*,|*,,*) err 'search source cannot be empty' ;;
  esac

  IFS=, read -r -a sources <<<"$source"

  for source in "${sources[@]}"; do
    case "$source" in
      openalex|core|eric) ;;
      *) err "search: unknown source '$source'" ;;
    esac
  done

  initialize

  tmp=$(mktemp -d "$CACHE/search.XXXXXX")
  defer "$tmp"

  for source in "${sources[@]}"; do
    if ! "search_$source" "$query" "$limit" >"$tmp/$source"; then
      echo '[]' >"$tmp/$source"
    fi
  done

  result=$(merge_results "$limit" "$tmp"/*)
  result=$(fix_url_ids "$result")

  if [ "$format" = json ]; then
    echo "$result" | jq .
  else
    echo "$result" | render_pretty_search_results
  fi
}

openalex_abstract_filter='def abstract: .abstract_inverted_index as $a | if $a==null then null else reduce ($a|to_entries[]) as $e ([]; reduce $e.value[] as $p (.; . + [{p:$p,w:$e.key}])) | sort_by(.p) | map(.w) | join(" ") end;'

search_openalex() {
  body=$(http openalex 86400 "https://api.openalex.org/works?search=$(uri "$1")&per-page=$2&mailto=$(uri "$UB_EMAIL")${OPENALEX_API_KEY:+&api_key=$(uri "$OPENALEX_API_KEY")}") || return

  echo "$body" | jq "$openalex_abstract_filter"' [.results|to_entries[]|.key as $rank|.value|{
    provider:"openalex",rank:($rank+1),provider_id:.id,doi:(.doi//""|sub("^https?://(dx\\.)?doi.org/";"")|ascii_downcase),
    url:(.doi//.primary_location.landing_page_url//.id),title:.title,authors:[.authorships[].author.display_name],year:.publication_year,
    type:.type,citations:.cited_by_count,oa:(.open_access.is_oa//false),abstract:abstract,
    versions:[.locations[]?|select(.landing_page_url!=null)|{url:.landing_page_url,version:.version,pdf_url:.pdf_url}]
  }|with_entries(select(.value!=null and .value!=""))]'
}

search_core() {
  if [ -z "${CORE_API_KEY:-}" ]; then
    warn 'core: CORE_API_KEY is not set'
    echo '[]'
    return
  fi

  body=$(http core 86400 "https://api.core.ac.uk/v3/search/works?q=$(uri "$1")&limit=$2" -H "Authorization: Bearer $CORE_API_KEY") || return

  echo "$body" | jq '[.results|to_entries[]|.key as $rank|.value|{
    provider:"core",rank:($rank+1),provider_id:(.id|tostring),doi:(.doi//""|sub("^https?://(dx\\.)?doi.org/";"")|ascii_downcase),
    url:(if .doi then "https://doi.org/"+.doi else .downloadUrl//.sourceFulltextUrls[0]//empty end),title:.title,
    authors:[.authors[]?.name // .authors[]?],year:(.yearPublished//.publishedDate[0:4]?|tonumber?),type:(.documentType//empty),
    citations:(.citationCount//0),oa:(.isOpenAccess//(.downloadUrl!=null)),abstract:(.abstract//empty),
    versions:[{url:(.downloadUrl//empty),version:"unknown",pdf_url:(.downloadUrl//empty)}]|map(select(.url!=""))
  }|with_entries(select(.value!=null and .value!=""))]'
}

search_eric() {
  body=$(http eric 86400 "https://api.ies.ed.gov/eric/?search=$(uri "$1")&format=json&rows=$2") || return

  echo "$body" | jq '[.response.docs|to_entries[]|.key as $rank|.value|{
    provider:"eric",rank:($rank+1),provider_id:(.id//empty),doi:(.doi//""|sub("^https?://(dx\\.)?doi.org/";"")|ascii_downcase),
    url:(if .doi then "https://doi.org/"+.doi else .url//("https://eric.ed.gov/?id="+.id) end),title:.title,
    authors:([.author[]? // .author?]|flatten|map(select(.!=null))),year:(.publicationdateyear//.publicationdate[0:4]?|tonumber?),
    type:([.publicationtype[]?][0]//empty),oa:(.availability?=="Download full text"),abstract:(.description//empty),citations:0
  }|with_entries(select(.value!=null and .value!=""))]'
}

merge_results() {
  jq -s --argjson limit "$1" '
    def norm: ascii_downcase|gsub("[^[:alnum:]]";"");
    def surname: split(" ")[-1]|norm;
    add | map(. + {group:(if .doi!="" then "doi:"+.doi else ((.title|norm)+"|"+((.authors[0]? // "")|surname)+"|"+(.year//""|tostring)) end)})
    | group_by(.group) | map(
      sort_by(.rank) as $v | reduce $v[] as $x ({score:0,sources:[],versions:[]};
        .score += (1/(60+$x.rank)) | .sources += [$x.provider] | .versions += ($x.versions//[]) |
        .doi //= $x.doi | .url //= $x.url | .title //= $x.title | .authors //= $x.authors | .year //= $x.year |
        .type //= $x.type | .citations = ([.citations//0,$x.citations//0]|max) | .oa = ((.oa//false) or ($x.oa//false)) |
        .abstract //= $x.abstract | .provider_ids = ((.provider_ids//{}) + {($x.provider):$x.provider_id})
      )
      | .sources = (.sources|unique) | .versions = (.versions|unique_by(.url))
      | .id=(if (.doi//"")!="" then "doi-"+.doi else "url-" end)
      | del(.doi,.versions,.provider_ids,.group)
      | with_entries(select(.value!=null and .value!=""))
    ) | sort_by(-.score) | .[:$limit] | map(del(.score))' "${@:2}"
}

# TODO(robin): get rid of the unreadable jq mess and refactor this along the way.
fix_url_ids() {
  # NOTE: jq has no portable sha256 filter. Replace URL IDs after merging.
  out='[]'
  n=$(echo "$1" | jq 'length')
  i=0
  while [ "$i" -lt "$n" ]; do
    row=$(echo "$1" | jq ".[$i]")
    id=$(echo "$row" | jq -r '.id')
    if [ "$id" = url- ]; then id=url-$(digest "$(echo "$row" | jq -r '.url')" | cut -c1-12); row=$(echo "$row" | jq --arg id "$id" '.id=$id'); fi
    out=$(jq -nc --argjson a "$out" --argjson r "$row" '$a+[$r]')
    i=$((i + 1))
  done
  echo "$out"
}

render_pretty_search_results() {
  jq -r '
    def family: if contains(",") then split(",")[0] else split(" ")[-1] end;
    def people: if (.authors|length)==0 then "Unknown" elif (.authors|length)==1 then (.authors[0]|family)
      elif (.authors|length)==2 then (.authors[0]|family)+" & "+(.authors[1]|family) else (.authors[0]|family)+" et al." end;
    def short: gsub("[[:space:]]+";" ") | if length>400 then .[:399]+"…" else . end;
    .[] | (people+" ("+((.year//"n.d.")|tostring)+"). "+(.title//"Untitled")),
      ("["+.id+"] "+.url),
      ("type:"+(.type//"unknown")+" citations:"+((.citations//0)|tostring)+" oa:"+(if .oa then "yes" else "no" end)+" sources:"+(.sources|join(","))),
      (if .abstract then "\nAbstract: "+(.abstract|short) else empty end), ""'
}

inspect() {
  arg --define format --default "$UB_FORMAT"

  arg --parse "$@"

  if [ "${#argv[@]}" -eq 0 ]; then
    err 'missing doi or url'
  fi

  if [ "${#argv[@]}" -gt 1 ]; then
    err "unexpected argument '${argv[1]}'"
  fi

  case "$format" in
    pretty|json) ;;
    *) err "unknown output format '$format'" ;;
  esac

  initialize

  result=$(inspect_object "${argv[0]}")

  if [ "$format" = json ]; then
    echo "$result" | jq 'del(._locations,._openalex_id,._relations,.doi) | with_entries(select(.value!=[]))';
  else
    echo "$result" | render_pretty_inspect;
  fi
}

inspect_object() {
  oa='{}' cr='{}' dc='{}' up='{}' core='{}' linked='[]'

  id=$(identifier "$1");
  doi=$(echo "$id" | jq -r '.doi//empty')
  oa=$(fetch_openalex "$id" || echo '{}')

  if [ -n "$doi" ]; then
    cr=$(fetch_crossref "$doi" || echo '{}')
    dc=$(fetch_datacite "$doi" || echo '{}')
    up=$(fetch_unpaywall "$doi" || echo '{}')
    core=$(fetch_core "$doi" || echo '{}')
    linked=$(linked_locations "$cr" "$dc")
  fi

  rel=$(relation_evidence "$cr" "$dc")
  osf=$(osf_evidence "$doi")
  retraction=$(retraction_evidence "$doi" "$cr")
  replication=$(replication_evidence "$doi")

  result=$(jq -nc --argjson i "$id" --argjson oa "$oa" --argjson cr "$cr" --argjson dc "$dc" --argjson up "$up" --argjson core "$core" --argjson linked "$linked" --argjson rel "$rel" --argjson osf "$osf" --argjson replication "$replication" --arg retraction "$retraction" "$openalex_abstract_filter"'
    def names: [.authorships[]?.author.display_name];
    def dcauthors: [.creators[]?.familyName // .creators[]?.name];
    def crauthors: [.author[]?.family // .author[]?.name];
    def nonempty: with_entries(select(.value!=null and .value!="" and .value!=[]));
    ($i + {
      title:($cr.title[0]//$dc.titles[0].title//$oa.title),
      authors:(if ($cr.author//[]|length)>0 then ($cr|crauthors) elif ($dc.creators//[]|length)>0 then ($dc|dcauthors) else ($oa|names) end),
      year:($cr.published["date-parts"][0][0]//$dc.publicationYear//$oa.publication_year),
      type:($cr.type//$dc.types.resourceTypeGeneral//$oa.type),citations:($oa.cited_by_count//0),
      references:(($oa.referenced_works//[])|length),oa:($oa.open_access.is_oa//$up.is_oa//false),
      abstract:(($oa|abstract)//(if $cr.abstract then ($cr.abstract|gsub("<[^>]+>";" ")|gsub("[[:space:]]+";" ")) else null end)//([$dc.descriptions[]?|select(.descriptionType=="Abstract")|.description][0])),
      predatory:(if $oa.primary_location.source.is_in_doaj==true then "clear" else "unknown" end),retraction:$retraction,
      preregistrations:(($rel.preregistrations+$osf.preregistrations)|unique_by(.url)),
      datasets:(($rel.datasets+$osf.datasets)|unique_by(.url)),replications:$replication,
      _locations:([ $oa.best_oa_location, $up.best_oa_location, $up.oa_locations[]?, $oa.locations[]?, $linked[]?, ($core.results[]?|{pdf_url:(.downloadUrl//.sourceFulltextUrls[0]//null),version:"unknown",provider:"core"}) ]|map(select(.!=null))|unique_by(.pdf_url//.url//.landing_page_url)),
      _openalex_id:($oa.id//null),
      _relations:{crossref:($cr.relation//{}),datacite:($dc.relatedIdentifiers//[])}
    }|nonempty)')

  record_object "$result"
  echo "$result"
}

record_object() {
  key=$(echo "$1" | jq -r .id)
  doi=$(echo "$1" | jq -r '.doi//empty')
  url=$(echo "$1" | jq -r .url)

  now=$(date +%s)

  qmeta=$(escape "$(echo "$1" | jq -c .)")

  query "$LIBRARY_DB" "INSERT INTO works(
    key,
    doi,
    canonical_url,
    metadata,
    updated_at
  ) VALUES(
    '$(escape "$key")',
    '$(escape "$doi")',
    '$(escape "$url")',
    '$qmeta',
    $now
  ) ON CONFLICT(key) DO UPDATE SET
    doi=excluded.doi,
    canonical_url=excluded.canonical_url,
    metadata=excluded.metadata,
    updated_at=excluded.updated_at;"

  query "$LIBRARY_DB" "INSERT OR REPLACE INTO aliases(alias, work_key)
    VALUES('$(escape "$url")', '$(escape "$key")');"

  if [ -n "$doi" ]; then
    query "$LIBRARY_DB" "INSERT OR REPLACE INTO aliases(alias, work_key)
      VALUES('$(escape "$doi")', '$(escape "$key")'), ('https://doi.org/$(escape "$doi")', '$(escape "$key")');"
  fi

  oa_id=$(echo "$1" | jq -r '._openalex_id//empty')

  if [ -n "$oa_id" ]; then
    query "$LIBRARY_DB" "INSERT OR REPLACE INTO provider_ids(provider, provider_id, work_key)
      VALUES('openalex', '$(escape "$oa_id")', '$(escape "$key")');"
  fi

  while IFS= read -r row; do
    if [ -z "$row" ]; then
      continue
    fi

    location=$(echo "$row" | jq -r '.pdf_url//.url_for_pdf//.landing_page_url//.url//empty')

    if [ -z "$location" ]; then
      continue
    fi

    version=$(echo "$row" | jq -r '.version//"unknown"')

    query "$LIBRARY_DB" "INSERT OR REPLACE INTO versions(work_key, version, url, metadata)
      VALUES('$(escape "$key")', '$(escape "$version")', '$(escape "$location")', '$(escape "$row")');"

  done < <(echo "$1" | jq -c '._locations[]?')
}

fetch_openalex() {
  doi=$(echo "$1" | jq -r '.doi // empty')

  if [ -n "$doi" ]; then
    url="https://api.openalex.org/works/https://doi.org/$(uri "$doi")?mailto=$(uri "$UB_EMAIL")"
  else
    url="https://api.openalex.org/works?filter=locations.landing_page_url.search:$(uri "$(echo "$1" | jq -r .url)")&per-page=1&mailto=$(uri "$UB_EMAIL")"
  fi

  body=$(http openalex 604800 "$url") || return 1
  echo "$body" | jq 'if .results then .results[0] else . end'
}

fetch_crossref() {
  body=$(http crossref 604800 "https://api.crossref.org/works/$(uri "$1")?mailto=$(uri "$UB_EMAIL")") || return 1
  echo "$body" | jq '.message'
}

fetch_datacite() {
  body=$(http datacite 604800 "https://api.datacite.org/dois/$(uri "$1")") || return 1
  echo "$body" | jq '.data.attributes'
}

fetch_unpaywall() {
  body=$(http unpaywall 604800 "https://api.unpaywall.org/v2/$(uri "$1")?email=$(uri "$UB_EMAIL")") || return 1
  echo "$body"
}

fetch_core() {
  if [ -z "${CORE_API_KEY:-}" ]; then
    echo '{}'
    return
  fi

  body=$(http core 604800 "https://api.core.ac.uk/v3/search/works?q=$(uri "doi:$1")&limit=10" -H "Authorization: Bearer $CORE_API_KEY") || return 1
  echo "$body" | jq '{results:[.results[]?|select((.doi//""|ascii_downcase)==$doi)|{id:(.id|tostring),downloadUrl,sourceFulltextUrls}]}' --arg doi "$1"
}

linked_locations() {
  result='[]'

  while IFS=$'\t' read -r relation doi; do
    if [ -z "$doi" ]; then
      continue
    fi

    case "$relation" in
      *preprint*|*Preprint*) version=submittedVersion ;;
      *) version=acceptedVersion ;;
    esac

    up=$(fetch_unpaywall "$doi" 2>/dev/null || echo '{}')

    result=$(jq -nc \
      --argjson a "$result" \
      --argjson up "$up" \
      --arg version "$version" \
      '[ $up.best_oa_location,$up.oa_locations[]? ]|map(select(.!=null)|.version=$version) as $new|$a+$new')

  done < <(
    jq -nr --argjson cr "$1" --argjson dc "$2" '($cr.relation//{}|to_entries[]?|select(.key|test("preprint|manuscript";"i"))|.key as $k|.value[]?|[$k,(.id//.)]|@tsv),($dc.relatedIdentifiers[]?|select(.relationType|test("Preprint|Version";"i"))|[.relationType,.relatedIdentifier]|@tsv)'
  )

  echo "$result"
}

relation_evidence() {
  jq -nc --argjson cr "$1" --argjson dc "$2" '
    def id($u): ($u|sub("^https?://(dx\\.)?doi.org/";"")|ascii_downcase) as $d |
      if $d|startswith("10.") then {id:("doi-"+$d),url:("https://doi.org/"+$d)} else {url:$u} end;
    [($cr.relation//{}|to_entries[]? as $r|$r.value[]?|select($r.key|test("pre-register|registration";"i"))|id(.id//.)+{source:"crossref"})] as $precr |
    [($dc.relatedIdentifiers[]?|select(.relationType|test("PreRegistration";"i"))|id(.relatedIdentifier)+{source:"datacite"})] as $predc |
    [($cr.relation//{}|to_entries[]? as $r|$r.value[]?|select($r.key|test("dataset|data";"i"))|id(.id//.)+{access:"unknown",source:"crossref"})] as $datacr |
    [($dc.relatedIdentifiers[]?|select(.relationType|test("Data|Supplement|Material";"i"))|id(.relatedIdentifier)+{access:"unknown",source:"datacite"})] as $datadc |
    [($cr.assertion[]?|select((.label//.name//"")|test("data|availability";"i"))|{access:(if ((.value//"")|test("restricted|request|not available";"i")) then "restricted" else "statement" end),statement:.value,source:"crossref"})] as $statements |
    {preregistrations:($precr+$predc|unique_by(.url)),datasets:($datacr+$datadc+$statements|unique_by(.url//.statement))}'
}

osf_evidence() {
  # OSF does not support DOI filtering. OSF links asserted by Crossref or
  # DataCite are retained by relation_evidence instead of guessed by title.
  jq -nc '{preregistrations:[],datasets:[]}'
}

retraction_evidence() {
  status=clear modified=0 age=9999999

  if [ -z "$1" ]; then
    echo 'unknown'
    return
  fi

  updates=$(echo "$2" | jq -r '[.update_to[]?.type,((.relation//{})|keys[]?)]|join(" ")|ascii_downcase')

  # TODO(robin): DRY this
  case "$updates" in
    *retract*) status=retracted ;;
    *expression*concern*) status=expression_of_concern ;;
    *correct*) status=corrected ;;
  esac

  if [ "$status" = clear ]; then
    if [ -f "$UB_RETRACTIONS_LOCAL" ]; then
      modified=$(modified_at "$UB_RETRACTIONS_LOCAL")
    fi

    age=$(($(date +%s) - modified))

    if [ "$age" -gt 1209600 ]; then
      if [ -f "$UB_RETRACTIONS_LOCAL" ]; then
        warn "retraction watch: data is more than 2 weeks old, consider running 'ub pull'"
      else
        warn "retraction watch: retraction data unavailable, run 'ub pull' to download"
        status=unknown
      fi
    fi

    if [ -f "$UB_RETRACTIONS_LOCAL" ]; then
      index_retractions

      nature=$(query "$HTTP_DB" "SELECT lower(nature) FROM retractions WHERE original_doi='$(escape "$1")';")

      # TODO(robin): DRY this
      case "$nature" in
        *retract*) status=retracted ;;
        *expression*concern*) status=expression_of_concern ;;
        *correct*) status=corrected ;;
      esac
    fi
  fi

  echo "$status"
}

replication_evidence() {
  modified=0 age=9999999

  if [ -z "$1" ]; then
    echo '[]'
    return
  fi

  if [ -f "$UB_REPLICATIONS_LOCAL" ]; then
    modified=$(modified_at "$UB_REPLICATIONS_LOCAL")
  fi

  age=$(($(date +%s) - modified))

  if [ "$age" -gt 604800 ]; then
    if [ -f "$UB_REPLICATIONS_LOCAL" ]; then
      warn "fred: data is more than 1 week old; consider running 'ub pull'"
    else
      warn "fred: data is unavailable; run 'ub pull'"
      echo '[]'
      return
    fi
  fi

  tmp=$(mktemp -d "$CACHE/fred.XXXXXX")
  defer "$tmp"

  if ! unzip -q "$UB_REPLICATIONS_LOCAL" -d "$tmp"; then
    warn 'fred: dataset is corrupted'
    echo '[]'
    return
  fi

  script=$tmp/read.js

  cat >"$script" <<-JS
    const crypto = require('crypto'), fs = require('fs');
    const [root, requested] = process.argv.slice(2);

    const decode = s => s.replace(/&amp;/g,'&')
                         .replace(/&lt;/g,'<')
                         .replace(/&gt;/g,'>')
                         .replace(/&quot;/g,'"')
                         .replace(/&apos;|&#39;/g,"'");

    const shared = [...fs.readFileSync(root+'/xl/sharedStrings.xml','utf8')
      .matchAll(/<si>([\s\S]*?)<\/si>/g)]
      .map(m => decode([...m[1].matchAll(/<t[^>]*>([\s\S]*?)<\/t>/g)].map(x=>x[1]).join('')));

    const sheet = fs.readFileSync(root+'/xl/worksheets/sheet1.xml','utf8'), found=[], seen=new Set();

    for (const row of sheet.matchAll(/<row[^>]*>([\s\S]*?)<\/row>/g)) {
      const cells={};

      for (const c of row[1].matchAll(/<c\s+([^>]*?)(?:\/>|>([\s\S]*?)<\/c>)/g)) {
        const col=(c[1].match(/r="([A-Z]+)/)||[])[1], raw=((c[2]||'').match(/<v>([\s\S]*?)<\/v>/)||[])[1];
        if (col && raw != null) cells[col]=/t="s"/.test(c[1]) ? shared[+raw] : decode(raw);
      }

      if ((cells.E||'').trim().toLowerCase() !== requested.toLowerCase() || seen.has(cells.A)) continue;

      seen.add(cells.A);

      const repdoi=(cells.H||'').replace(/^https?:\/\/(dx\.)?doi.org\//i,'').trim().toLowerCase();
      const url=repdoi ? 'https://doi.org/'+repdoi : (cells.I||'').trim();

      if (!url) continue;

      found.push({outcome:cells.AJ||'unknown',id:repdoi?'doi-'+repdoi:'url-'+crypto.createHash('sha256').update(url).digest('hex').slice(0,12),url,
        title:cells.AT||undefined,year:cells.AW&&/^\d+$/.test(cells.AW)?+cells.AW:undefined,source:'fred'});
    }

	process.stdout.write(JSON.stringify(found));
	JS

  node "$script" "$tmp" "$1"
}

render_pretty_inspect() {
  jq -r '
    def family: if contains(",") then split(",")[0] else split(" ")[-1] end;
    def people: if (.authors|length)==0 then "Unknown" elif (.authors|length)==1 then (.authors[0]|family) elif (.authors|length)==2 then (.authors[0]|family)+" & "+(.authors[1]|family) else (.authors[0]|family)+" et al." end;
    def short: gsub("[[:space:]]+";" ")|if length>400 then .[:399]+"…" else . end;
    def list($name;$xs;$kind): if ($xs|length)>0 then "\n"+$name+":\n"+([$xs[:4][]|(if $kind=="data" then (.access//"unknown")+"\t" elif $kind=="replication" then (.outcome//"unknown")+"\t" else "" end)+(if .id then "["+.id+"] "+.url else (.statement//.url//"unknown") end)]|join("\n"))+(if ($xs|length)>4 then "\n(+ "+(($xs|length)-4|tostring)+" more)" else "" end) else "" end;
    people+" ("+((.year//"n.d.")|tostring)+"). "+(.title//"Untitled")+"\n["+.id+"] "+.url+
    (if .abstract then "\n\nAbstract: "+(.abstract|short) else "" end)+
    "\n\ntype:\t"+(.type//"unknown")+"\toa:\t"+(if .oa then "yes" else "no" end)+
    "\ncitations:\t"+((.citations//0)|tostring)+"\treferences:\t"+((.references//0)|tostring)+
    "\npredatory:\t"+(.predatory//"unknown")+"\tretraction:\t"+(.retraction//"unknown")+
    list("Preregistration(s)";(.preregistrations//[]);"plain")+
    list("Dataset(s)";(.datasets//[]);"data")+
    list("Replication";(.replications//[]);"replication")'
}

node_from_oa() {
  jq "$openalex_abstract_filter"' {openalex_id:.id,doi:(.doi//""|sub("^https?://(dx\\.)?doi.org/";"")|ascii_downcase),url:(.doi//.primary_location.landing_page_url//.id),title:.title,authors:[.authorships[].author.display_name],year:.publication_year} | .id=(if .doi!="" then "doi-"+.doi else "url-" end) | del(.doi)'
}

opencitations_related() {
  case "$2" in references) endpoint=references; field=cited; relation=reference ;; citations) endpoint=citations; field=citing; relation=citation ;; esac
  body=$(http opencitations 604800 "https://opencitations.net/index/coci/api/v1/$endpoint/$(uri "$1")") || return
  echo "$body" | jq -r --arg field "$field" --arg relation "$relation" '.[]?|.[$field]?|select(.)|$relation+"\tdoi:"+(ascii_downcase)'
}

recurse() {
  arg --define depth --default 1
  arg --define direction --default both
  arg --define limit --default 50
  arg --define format --default "$UB_FORMAT"

  arg --parse "$@"

  if [ "${#argv[@]}" -eq 0 ]; then
    err 'missing doi or url'
  fi

  if [ "${#argv[@]}" -gt 1 ]; then
    err "unexpected argument '${argv[1]}'"
  fi

  case "$depth:$limit" in
    :*|*:|*[!0-9:]*) err 'depth and limit must be non-negative integers' ;;
  esac

  case "$direction" in
    citations|references|both) ;;
    *) err "unknown recurse direction '$direction'" ;;
  esac

  case "$format" in
    pretty|json) ;;
    *) err "unknown output format '$format'" ;;
  esac

  initialize
  discovered=0 truncated=false

  id=$(identifier "${argv[0]}")
  seed=$(fetch_openalex "$id" | node_from_oa) || err 'recurse: seed was not found in OpenAlex'

  tmp=$(mktemp -d "$CACHE/recurse.XXXXXX")
  defer "$tmp"
  queue=$tmp/queue
  nodes=$tmp/nodes
  edges=$tmp/edges

  : >"$queue"
  : >"$nodes"
  : >"$edges"

  seed_id=$(echo "$seed" | jq -r .id)
  oa_id=$(echo "$seed" | jq -r .openalex_id)

  if [ "$seed_id" = url- ]; then
    seed_id=url-$(digest "$(echo "$seed" | jq -r .url)" | cut -c1-12)
    seed=$(echo "$seed" | jq --arg id "$seed_id" '.id=$id')
  fi

  echo "$seed" >>"$nodes"
  printf '0\t%s\t%s\n' "$oa_id" "$seed_id" >>"$queue"

  while IFS=$'\t' read -r level current current_id; do
    if [ "$level" -ge "$depth" ]; then
      continue
    fi

    current_doi=${current_id#doi-}

    work=$(http openalex 604800 "https://api.openalex.org/works/$current?mailto=$(uri "$UB_EMAIL")" || echo '{}')

    if [ "$direction" = references ] || [ "$direction" = both ]; then
      if [ "$work" != '{}' ]; then
        echo "$work" | jq -r '.referenced_works[]?' | \
          while read -r target; do printf 'reference\t%s\n' "$target"; done >"$tmp/related"

      elif [ "$current_doi" != "$current_id" ]; then
        opencitations_related "$current_doi" references >"$tmp/related"
      else
        : >"$tmp/related"
      fi
    else
      : >"$tmp/related"
    fi

    if [ "$direction" = citations ] || [ "$direction" = both ]; then
      if body=$(http openalex 604800 "https://api.openalex.org/works?filter=cites:$current&per-page=200&mailto=$(uri "$UB_EMAIL")"); then
        echo "$body" | jq -r '.results[]?.id' | \
          while read -r target; do printf 'citation\t%s\n' "$target"; done >>"$tmp/related"

      elif [ "$current_doi" != "$current_id" ]; then
        opencitations_related "$current_doi" citations >>"$tmp/related"
      fi
    fi

    while IFS=$'\t' read -r relation target; do
      if [ -z "$target" ]; then
        continue
      fi

      if [[ "$target" = doi:* ]]; then
        target_doi=${target#doi:}
        target_id=$(identifier "$target_doi")

        if target_node=$(fetch_openalex "$target_id" 2>/dev/null | node_from_oa) && [ -n "$target_node" ]; then
          target_oa=$(echo "$target_node" | jq -r '.openalex_id|split("/")[-1]')
        else
          target_oa=
          target_node=$(jq -nc --arg doi "$target_doi" '{id:("doi-"+$doi),url:("https://doi.org/"+$doi),authors:[]}')
        fi
      else
        target_oa=${target##*/}
        target_node=$(http openalex 604800 "https://api.openalex.org/works/$target_oa?mailto=$(uri "$UB_EMAIL")" 2>/dev/null | node_from_oa) || continue
      fi

      target_id=$(echo "$target_node" | jq -r .id)

      if [ "$target_id" = url- ]; then
        target_id=url-$(digest "$(echo "$target_node" | jq -r .url)" | cut -c1-12)
        target_node=$(echo "$target_node" | jq --arg id "$target_id" '.id=$id')
      fi

      if ! quiet jq -e --arg id "$target_id" 'select(.id==$id)' "$nodes"; then
        if [ "$discovered" -ge "$limit" ]; then
          truncated=true
          continue
        fi

        echo "$target_node" >>"$nodes"

        if [ -n "$target_oa" ]; then
          printf '%s\t%s\t%s\n' "$((level + 1))" "$target_oa" "$target_id" >>"$queue"
        fi

        discovered=$((discovered + 1))
      fi
      if [ "$relation" = reference ]; then
        printf '%s\t%s\n' "$current_id" "$target_id" >>"$edges"
      else
        printf '%s\t%s\n' "$target_id" "$current_id" >>"$edges"
      fi
    done <"$tmp/related"
  done <"$queue"

  result=$(jq -nc --arg seed "$seed_id" --slurpfile n "$nodes" --rawfile e "$edges" --argjson truncated "$truncated" \
    '{seed:$seed,nodes:($n|unique_by(.id)|map(del(.openalex_id))),edges:($e|split("\n")|map(select(length>0)|split("\t"))|unique),truncated:$truncated}')

  if [ "$format" = json ]; then
    echo "$result" | jq .;
  else
    echo "$result" | jq -r '
    def family: if contains(",") then split(",")[0] else split(" ")[-1] end;
    def people: if (.authors|length)==0 then "Unknown" elif (.authors|length)==1 then (.authors[0]|family) elif (.authors|length)==2 then (.authors[0]|family)+" & "+(.authors[1]|family) else (.authors[0]|family)+" et al." end;
    "Nodes:\n",(.nodes[]|"["+.id+"] "+people+" ("+((.year//"n.d.")|tostring)+"). "+(.title//"Untitled")),"\nRelations:\n",(.edges[]|"["+.[0]+"] cites ["+.[1]+"]")';
  fi
}

download() {
  arg --define format --default "$UB_FORMAT"
  arg --parse "$@"

  if [ "${#argv[@]}" -eq 0 ]; then
    err 'missing doi or url'
  fi

  if [ "${#argv[@]}" -gt 1 ]; then
    err "unexpected argument '${argv[1]}'"
  fi

  case "$format" in
    pretty|json) ;;
    *) err "unknown output format '$format'" ;;
  esac

  initialize

  meta=$(inspect_object "${argv[0]}")
  path=$(retrieve "$meta")

  if [ "$format" = json ]; then
    jq -Rn --arg path "$path" '$path'
  else
    echo "$path"
  fi
}

retrieve() {
  key=$(echo "$1" | jq -r .id)

  path=$(query "$LIBRARY_DB" "SELECT path FROM files WHERE work_key='$(escape "$key")' AND path!=''
    ORDER BY CASE version WHEN 'publishedVersion' THEN 0 WHEN 'acceptedVersion' THEN 1 ELSE 2 END LIMIT 1;")

  if [ -n "$path" ] && [ -f "$path" ]; then
    echo "$path"
    return
  fi

  candidates=$(echo "$1" | jq -c '[._locations[]? |
    {url:(.pdf_url//.url_for_pdf//empty),version:(.version//"unknown")}] |
    map(select(.url!="")) | unique_by(.url) |
    sort_by(if .version=="publishedVersion" then 0
      elif .version=="acceptedVersion" then 1
      elif .version=="submittedVersion" then 2 else 3 end) | .[]')

  while IFS= read -r row; do
    if [ -z "$row" ]; then
      continue
    fi

    url=$(echo "$row" | jq -r .url)
    version=$(echo "$row" | jq -r .version)

    if path=$(direct_download "$1" "$url" "$version" 2>/dev/null); then
      echo "$path"
      return
    fi
  done <<<"$candidates"

  err 'no publicly downloadable pdf found'
}

direct_download() {
  tmp=$(mktemp "$CACHE/download.XXXXXX")
  defer "$tmp"

  if ! curl -L --connect-timeout 15 --max-time 180 -fsS -H 'Accept: application/pdf' "$2" -o "$tmp"; then
    return 1 # do not exit, try other candidates first
  fi

  if ! valid_pdf "$tmp"; then
    return 1 # do not exit, try other candidates first
  fi

  record_download "$1" "$tmp" "$3" "$2"
}

record_download() {
  key=$(echo "$1" | jq -r .id)
  hash=$(digest <"$2")
  existing=$(query "$LIBRARY_DB" "SELECT path FROM files WHERE sha256='$hash' LIMIT 1;")

  if [ -n "$existing" ] && [ -f "$existing" ]; then
    path=$existing
    rm -f "$2"
  else
    name=$(format_filename "$1" pdf)
    path=$UB_LITERATURE/$name

    if [ -e "$path" ]; then
      path=${path%.pdf}-${hash:0:8}.pdf
    fi

    mv "$2" "$path"
  fi

  query "$LIBRARY_DB" "INSERT OR REPLACE INTO files(
    work_key,
    version,
    path,
    sha256,
    source_url,
    created_at
  ) VALUES(
    '$(escape "$key")',
    '$(escape "$3")',
    '$(escape "$path")',
    '$hash',
    '$(escape "$4")',
    $(date +%s)
  );"

  echo "$path"
}

import() {
  arg --define move --flag
  arg --define format --default "$UB_FORMAT"
  arg --parse "$@"

  if [ "${#argv[@]}" -lt 2 ]; then
    err 'usage: ub import <doi|url> <path>'
  fi

  if [ "${#argv[@]}" -gt 2 ]; then
    err "unexpected argument '${argv[2]}'"
  fi

  case "$format" in
    pretty|json) ;;
    *) err "unknown output format '$format'" ;;
  esac

  source=${argv[1]}

  if ! valid_pdf "$source"; then
    err "import: '$source' is not a valid PDF"
  fi

  initialize

  meta=$(inspect_object "${argv[0]}")

  if [ "$move" -eq 1 ]; then
    incoming=$source
  else
    incoming=$(mktemp "$CACHE/import.XXXXXX")
    defer "$incoming"
    cp "$source" "$incoming"
  fi

  path=$(record_download "$meta" "$incoming" unknown "$(echo "$meta" | jq -r .url)")

  if [ "$format" = json ]; then
    jq -Rn --arg path "$path" '$path'
  else
    echo "$path"
  fi
}

view() {
  arg --define open --flag
  arg --define extract --flag
  arg --define format --default "$UB_FORMAT"
  arg --parse "$@"

  if [ "${#argv[@]}" -eq 0 ]; then
    err 'missing doi or url'
  fi

  if [ "${#argv[@]}" -gt 1 ]; then
    err "unexpected argument '${argv[1]}'"
  fi

  case "$format" in
    pretty|json) ;;
    *) err "unknown output format '$format'" ;;
  esac

  initialize

  key=$(identifier "${argv[0]}" | jq -r .id)
  path=$(query "$LIBRARY_DB" "SELECT path FROM files WHERE work_key='$(escape "$key")' AND path!=''
    ORDER BY CASE version WHEN 'publishedVersion' THEN 0 WHEN 'acceptedVersion' THEN 1 ELSE 2 END LIMIT 1;")

  if [ -z "$path" ] || [ ! -f "$path" ]; then
    err 'paper is not in the local library'
  fi

  if [ "$open" -eq 1 ]; then
    case "$(uname)" in
      Darwin) open "$path" ;;
      Linux) xdg-open "$path" ;;
      *) err 'plumbing is unsupported on your platform' ;;
    esac
  fi

  if [ "$extract" -eq 0 ]; then
    if [ "$format" = json ]; then
      jq -Rn --arg path "$path" '$path'
    else
      echo "$path"
    fi
    return
  fi

  meta=$(query "$LIBRARY_DB" "SELECT metadata FROM works WHERE key='$(escape "$key")';")
  result=$(extract "$meta" "$path")

  if [ "$format" = json ]; then
    echo "$result" | jq 'del(._locations,._openalex_id,._relations,.doi,.abstract,.type,.citations,.references,.oa,.retraction,.preregistrations,.datasets,.replications)'
  else
    echo "$result" | render_pretty_extraction
  fi
}

extract() {
  key=$(echo "$1" | jq -r .id)
  hash=$(digest <"$2")

  tmp=$UB_EXTRACTIONS/${key//\//:}
  mkdir -p "$tmp"

  cached=$(query "$LIBRARY_DB" "SELECT
      text_path,
      coalesce(structured_path,''),
      coalesce(sections,'null')
    FROM extractions WHERE work_key='$(escape "$key")' AND source_sha256='$hash';")

  if [ -n "$cached" ]; then
    IFS='|' read -r text structured sections <<<"$cached"

    if [ -f "$text" ]; then
      jq -nc --argjson m "$1" \
        --arg o "$2" \
        --arg t "$text" \
        --arg s "$structured" \
        --argjson sections "$sections" \
        '$m+{paths:{original:$o,text:$t,structured:(if $s=="" then null else $s end)},sections:$sections}'

      return
    fi
  fi

  pdf="$2"

  full="$tmp/extracted.txt"
  probe="$tmp/probe.txt"

  pdftotext -layout "$2" "$probe" || true
  chars=$(tr -d '[:space:]' <"$probe" | wc -c | tr -d ' ')

  if [ "$chars" -lt 200 ]; then
    pdf="$tmp/searchable.pdf"

    case "$(uname)" in
      Darwin) required mac-ocr; mac-ocr "$2" "$pdf" ;;
      Linux) required ocrmypdf; ocrmypdf --skip-text "$2" "$pdf" ;;
      *) err "OCR is unsupported on your platform" ;;
    esac
  fi

  pdftotext -layout "$pdf" "$full"

  # Normalize whitespace while preserving page/paragraph line boundaries.
  if awk '{gsub(/[[:space:]]+/," "); sub(/^ /,""); sub(/ $/,""); if ($0!="" || prev!="") print; prev=$0}' "$full" >"$full.tmp"; then
    mv "$full.tmp" "$full"
  fi

  structured=
  sections=null

  if [ -n "${UB_GROBID:-}" ]; then
    if has xmllint; then
      structured=$tmp/grobid.tei.xml

      count_pattern='count(//*[local-name()="text"]/*[local-name()="body"]//*[local-name()="div"]/*[local-name()="head"])'
      title_pattern='(//*[local-name()='text']/*[local-name()='body']//*[local-name()='div']/*[local-name()='head'])'

      if curl -fsS --connect-timeout 5 --max-time 120 -F "input=@$pdf" "${UB_GROBID%/}/api/processFulltextDocument" -o "$structured" && quiet xmllint --noout "$structured"; then
        titles='[]'

        count=$(swallow xmllint --xpath "$count_pattern" "$structured" | cut -d. -f1)

        i=1

        while [ "$i" -le "${count:-0}" ]; do
          title=$(swallow xmllint --xpath "string(${title_pattern}[$i])" "$structured" | tr '\n' ' ')

          if [ -n "$title" ]; then
            titles=$(jq -nc --argjson a "$titles" --arg t "$title" '$a+[$t]')
          fi

          i=$((i + 1))
        done

        sections=$(awk -v titles="$(echo "$titles" | jq -r '.[]')" '
          BEGIN{n=split(titles,t,"\n"); for(i=1;i<=n;i++) norm[tolower(t[i])]=i}
          {x=tolower($0); gsub(/[^[:alnum:] ]/,"",x); for(h in norm){y=h; gsub(/[^[:alnum:] ]/,"",y); if(x==y && !(norm[h] in at)){at[norm[h]]=NR; name[norm[h]]=h}}}
          END{for(i=1;i<=n;i++) if(i in at){e=NR; for(j=i+1;j<=n;j++) if(j in at){e=at[j]-1;break} printf "%s\t%d\t%d\n",name[i],at[i],e}}' "$full" | jq -Rn '[inputs|split("\t")|{title:.[0],start:(.[1]|tonumber),end:(.[2]|tonumber)}]')
      else
        warn "grobid: service unavailable, returning plain text"
        rm -f "$structured"

        structured=
        sections=null
      fi
    else
      warn "grobid: xmllint is required for grobid functionality but not installed"
    fi
  fi

  query "$LIBRARY_DB" "INSERT OR REPLACE INTO extractions(
    work_key,
    source_sha256,
    text_path,
    structured_path,
    sections,
    updated_at
  ) VALUES(
    '$(escape "$key")',
    '$hash',
    '$(escape "$full")',
    '$(escape "$structured")',
    '$(escape "$sections")',
    $(date +%s)
  );"

  jq -nc \
    --argjson m "$1" \
    --arg o "$2" \
    --arg t "$full" \
    --arg s "$structured" \
    --argjson sections "$sections" \
    '$m+{paths:{original:$o,text:$t,structured:(if $s=="" then null else $s end)},sections:$sections}'
}

render_pretty_extraction() {
  jq -r '
    def family: if contains(",") then split(",")[0] else split(" ")[-1] end;
    def people: if (.authors|length)==0 then "Unknown" elif (.authors|length)==1 then (.authors[0]|family) elif (.authors|length)==2 then (.authors[0]|family)+" & "+(.authors[1]|family) else (.authors[0]|family)+" et al." end;
    people+" ("+((.year//"n.d.")|tostring)+"). "+(.title//"Untitled")+"\n["+.id+"] "+.url+
    "\n\noriginal:\t"+.paths.original+"\ntext:\t"+.paths.text+
    (if .paths.structured then "\nstructured:\t"+.paths.structured else "" end)+
    (if .sections then "\n\nSections:\n\n"+([.sections[]|(.start|tostring)+"-"+(.end|tostring)+"\t"+.title]|join("\n")) else "" end)'
}

library() {
  args=()
  for value in "$@"; do
    case "$value" in
      -A) args+=(--all) ;;
      *) args+=("$value") ;;
    esac
  done

  arg --define all --flag
  arg --define format --default "$UB_FORMAT"
  arg --parse "${args[@]}"

  if [ "${#argv[@]}" -gt 0 ]; then
    err "unexpected argument '${argv[0]}'"
  fi

  case "$format" in
    pretty|json) ;;
    *) err "unknown output format '$format'" ;;
  esac

  initialize

  if [ "$all" -eq 1 ]; then
    filter=
  else
    filter='WHERE EXISTS (SELECT 1 FROM files WHERE files.work_key=works.key)'
  fi

  result=$(query "$LIBRARY_DB" "SELECT json_set(
      CASE WHEN json_valid(metadata) THEN metadata
        ELSE json_object('id', key, 'url', canonical_url, 'authors', json('[]')) END,
      '$.path', (
        SELECT path FROM files WHERE files.work_key=works.key AND path!=''
        ORDER BY CASE version WHEN 'publishedVersion' THEN 0 WHEN 'acceptedVersion' THEN 1 ELSE 2 END LIMIT 1
      )
    ) FROM works $filter
    ORDER BY CASE WHEN json_valid(metadata) THEN coalesce(json_extract(metadata, '$.year'), 0) ELSE 0 END DESC,
      CASE WHEN json_valid(metadata) THEN json_extract(metadata, '$.title') ELSE key END;" |
    jq -s '[.[] | del(._locations,._openalex_id,._relations,.doi)]')

  if [ "$format" = json ]; then
    echo "$result" | jq .
  else
    echo "$result" | render_pretty_library
  fi
}

render_pretty_library() {
  jq -r '
    def family: if contains(",") then split(",")[0] else split(" ")[-1] end;
    def people: if (.authors|length)==0 then "Unknown" elif (.authors|length)==1 then (.authors[0]|family)
      elif (.authors|length)==2 then (.authors[0]|family)+" & "+(.authors[1]|family) else (.authors[0]|family)+" et al." end;
    .[] | people+" ("+((.year//"n.d.")|tostring)+"). "+(.title//"Untitled"),
      "["+.id+"] "+.url,
      (if .path then .path else "not downloaded" end), ""'
}

format_filename() {
  count=$(echo "$1" | jq '.authors|length')
  first=$(echo "$1" | jq -r '.authors[0]//"Unknown"')
  second=$(echo "$1" | jq -r '.authors[1]//empty')

  case "$first" in *,*) first=${first%%,*} ;; *) first=${first##* } ;; esac
  case "$second" in *,*) second=${second%%,*} ;; *) second=${second##* } ;; esac

  if [ "$count" -eq 1 ]; then names=$first
  elif [ "$count" -eq 2 ]; then names="$first & $second"
  else names="$first et al."; fi

  year=$(echo "$1" | jq -r '.year//"n.d."')
  id=$(echo "$1" | jq -r .id); label=${id//\//:}

  echo "$names ($year) [$label].$2"
}

for arg do
  case "$arg" in
    -h|--help) usage ;;
  esac
done

if [ "$#" -eq 0 ]; then
  usage
fi

case "$1" in
  pull) pull "${@:2}" ;;
  search) search "${@:2}" ;;
  inspect) inspect "${@:2}" ;;
  recurse) recurse "${@:2}" ;;
  download) download "${@:2}" ;;
  import) import "${@:2}" ;;
  view) view "${@:2}" ;;
  library) library "${@:2}" ;;
  *) err "unknown subcommand '$1'" ;;
esac
