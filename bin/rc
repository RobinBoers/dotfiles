#!/bin/sh
# Claude Code remote control sessions as systemd user units.

set -eu

: "${RC_PROJECTS_DIR:=$HOME/projects/*}"

usage() {
	echo "Usage: $(basename "$0") <subcommand> [project]"
	echo
	echo "SUBCOMMANDS"
	echo "  add                      Trust, enable and start a session server."
	echo "  remove, rm               Stop and disable a session server."
	echo "  list, ls                 List session servers."
	echo "  logs                     Follow the logs of a session server."
	echo "  restart [name|--all]     Restart session servers, e.g. after an update."
	echo "  run                      Run a session server in the foreground."
	echo
	echo "SHELL INTEGRATION"
	echo "  completions <shell>      Injects shell completions."
	echo
	echo "Projects are repos under \$RC_PROJECTS_DIR (or 'home' for ~)."
	echo "If no name is given, the current working directory is assumed."
	echo
	exit 0
}

unit() { printf 'rc@%s.service\n' "$1"; }

# Repo helpers

current_repo() {
	top=$(git rev-parse --show-toplevel 2>/dev/null) || err "not in a repo, specify a name"
	basename "$top"
}

resolve_repo() {
	if [ "$1" = 'home' ]; then
		printf '%s\n' "$HOME"
		return 0
	fi

	hits=$(printf '%s\n' "$RC_PROJECTS_DIR" | tr ':' '\n' | while read -r root; do
		# Can be a glob, so $root is deliberately unquoted.
		for p in $root/"$1"/; do
			p=${p%/}
			[ -d "$p/.git" ] || continue
			printf '%s\n' "$p"
		done
	done)

	if [ -z "$hits" ]; then
		err "no such repo '$1' in RC_PROJECTS_DIR"
	fi

	count=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')
	if [ "$count" -gt 1 ]; then
		err "ambiguous repo '$1': $(printf '%s\n' "$hits" | tr '\n' ' ')"
	fi

	printf '%s\n' "$hits"
}

# Config helpers

config() {
	printf '%s/.claude.json\n' "${CLAUDE_CONFIG_DIR:-$HOME}";
}

trusted() {
	jq -e --arg p "$1" '.projects[$p].hasTrustDialogAccepted == true' "$(config)" >/dev/null
}

trust() {
	tmp=$(mktemp "$(config).XXXXXX")
	jq --arg p "$1" '.projects[$p].hasTrustDialogAccepted = true' "$(config)" >"$tmp"
	mv "$tmp" "$(config)"
}

enabled() {
	jq -e '.remoteDialogSeen == true' "$(config)" >/dev/null
}

enable() {
	tmp=$(mktemp "$(config).XXXXXX")
	jq '.remoteDialogSeen = true' "$(config)" >"$tmp"
	mv "$tmp" "$(config)"
}

# Subcommands

cmd_add() {
	name=${1:-$(current_repo)}
	dir=$(resolve_repo "$name")

	[ -f "$(config)" ] || err "no $(config), log in to Claude first"

	if ! enabled; then
		prompt -y "Enable Remote Control on this machine?" || return 0
		enable
	fi

	if ! trusted "$dir"; then
		prompt -y "Trust $dir for Claude?" || return 0
		trust "$dir"
	fi

	systemctl --user enable --now "$(unit "$name")"
}

cmd_remove() {
	systemctl --user disable --now "$(unit "${1:-$(current_repo)}")"
}

cmd_list() {
	systemctl --user list-units --all --plain --no-legend 'rc@*' | awk '{
		name = $1
		sub(/^rc@/, "", name)
		sub(/\.service$/, "", name)
		printf "%-24s %s (%s)\n", name, $3, $4
	}'
}

cmd_logs() {
	journalctl --user -f -u "$(unit "${1:-$(current_repo)}")"
}

cmd_restart() {
	case "${1:-}" in
		--all) systemctl --user restart 'rc@*' ;;
		*) systemctl --user restart "$(unit "${1:-$(current_repo)}")" ;;
	esac
}

cmd_run() {
	[ -n "${1:-}" ] || err "run: specify a name"
	dir=$(resolve_repo "$1")

	# Only projects get worktrees.
	if [ "$1" = 'home' ]; then
		spawn='same-dir'
	else
		spawn='worktree'
	fi

	cd "$dir"
	exec claude remote-control --spawn "$spawn"
}

# Completion

list_repos() {
	printf '%s\n' "$RC_PROJECTS_DIR" | tr ':' '\n' | while read -r root; do
		# Can be a glob, so $root is deliberately unquoted.
		for p in $root/*/; do
			p=${p%/}
			[ -d "$p/.git" ] || continue
			printf '%s\n' "${p##*/}"
		done
	done
}

list_units() {
	has systemctl || return 0
	systemctl --user list-units --all --plain --no-legend 'rc@*' | awk '{
		name = $1
		sub(/^rc@/, "", name)
		sub(/\.service$/, "", name)
		print name
	}'
}

cmd_complete() {
	case "${1:-}" in
		commands) printf '%s\n' add remove rm list ls logs restart run completions ;;
		repos) echo home; list_repos ;;
		units) list_units ;;
	esac
}

cmd_completions() {
	case "${1:-}" in
		zsh)
			cat <<-'EOF'
				_rc() {
					if (( CURRENT == 2 )); then
						compadd -- ${(f)"$(command rc complete commands)"}
					elif (( CURRENT == 3 )); then
						case $words[2] in
							add|run) compadd -- ${(f)"$(command rc complete repos)"} ;;
							rm|remove|logs) compadd -- ${(f)"$(command rc complete units)"} ;;
							restart) compadd -- --all ${(f)"$(command rc complete units)"} ;;
							completions) compadd -- bash zsh ;;
						esac
					fi
				}
				compdef _rc rc
			EOF
			;;

		bash)
			cat <<-'EOF'
				_rc() {
					local cur=${COMP_WORDS[COMP_CWORD]}
					if [ "$COMP_CWORD" -eq 1 ]; then
						COMPREPLY=( $(compgen -W "$(command rc complete commands)" -- "$cur") )
					elif [ "$COMP_CWORD" -eq 2 ]; then
						case ${COMP_WORDS[1]} in
							add|run) COMPREPLY=( $(compgen -W "$(command rc complete repos)" -- "$cur") ) ;;
							rm|remove|logs) COMPREPLY=( $(compgen -W "$(command rc complete units)" -- "$cur") ) ;;
							restart) COMPREPLY=( $(compgen -W "--all $(command rc complete units)" -- "$cur") ) ;;
							completions) COMPREPLY=( $(compgen -W "bash zsh" -- "$cur") ) ;;
						esac
					fi
				}
				complete -F _rc rc
			EOF
			;;

		*) err "completions: unknown shell '${1:-}' (bash|zsh)" ;;
	esac
}

case "${1:-}" in
	complete) shift; cmd_complete "$@"; exit ;;
	completions) shift; cmd_completions "$@"; exit ;;
esac

required claude
required jq

case "${1:-}" in
	""|-h|--help) usage ;;
	add) shift; cmd_add "$@" ;;
	rm|remove) shift; cmd_remove "$@" ;;
	ls|list) shift; cmd_list ;;
	logs) shift; cmd_logs "$@" ;;
	restart) shift; cmd_restart "$@" ;;
	run) shift; cmd_run "$@" ;;
	*) err "unknown subcommand '$1'" ;;
esac
