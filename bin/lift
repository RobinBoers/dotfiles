#!/usr/bin/env bash
# Remote deployment manager for containers and static files.

set -euo pipefail

export TERM=xterm

required yq
required quiet
required has
required swallow

NET=liftastic

# Attempts to detect configuration directory on the current platform. This
# is probabily insufficient for Windows, but I doubt this is gonna work anyway.
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

usage() {
  echo "Usage: $(basename "$0") [opts] <subcommand> [args]"
  echo
  echo "OPTIONS"
  echo "  -c, --cluster NAME  Use cluster NAME."
  echo "  -h, --help          Show this help."
  echo
  echo "CLUSTER COMMANDS"
  echo "  setup HOST     Prepares HOST for lift, as a single-node cluster unless it already has one."
  echo "  apply          Applies the Clusterfile and containers.d of the current infra repo."
  echo "  status         Shows the applied revision per node."
  echo "  where          Lists which containers are declared on which nodes."
  echo "  dispatch       Ensures all containers are up on every node."
  echo "  provision      Recreates the given docker container(s) on their nodes."
  echo "  docker[@node]  Executes docker commands on a node."
  echo
  echo "PROJECT COMMANDS"
  echo "  launch         Interactively creates Liftfile."
  echo "  deploy         Builds and provisions containers, or syncs static files to every node."
  echo
  echo "Clusters are configured in $(echo $CONFIG_HOME | sed "s|^$HOME/||")/lift.yml"
  echo
  exit 0
}

# YAML helpers

has_key() {
  out=$(yq "$2" "$1")
  [ -n "$out" ] && [ ! "$out" = "null" ]
}

try_key() {
  if [ -f "$1" ] && has_key "$1" "$2"; then
    yq "$2" "$1"
  else
    return 1
  fi
}

# Config helpers

get() {
  key="${PREFIX:-}$1"

  try_key Liftfile .$key && return

  if [ -n "${PREFIX:-}" ]; then
    try_key Liftfile .$1 && return
  fi

  if [ -n "${DELEGATE_FILE:-}" ]; then
    try_key "$DELEGATE_FILE" .$1 && return
  fi

  err "$1: no such key in Liftfile"
}

get_or() {
  key="${PREFIX:-}$1"

  if has_key Liftfile .$key; then
    yq .$key Liftfile
  elif [ -n "${PREFIX:-}" ] && has_key Liftfile .$1; then
    yq .$1 Liftfile
  elif [ -n "${DELEGATE_FILE:-}" ] && has_key "$DELEGATE_FILE" .$1; then
    yq .$1 "$DELEGATE_FILE"
  else
    echo "$2"
  fi
}

global_get() {
  key="${PREFIX:-}$1"

  try_key Liftfile .$key && return

  if [ -n "${PREFIX:-}" ]; then
    try_key Liftfile .$1 && return
  fi

  if [ -n "${DELEGATE_FILE:-}" ]; then
    try_key "$DELEGATE_FILE" .$1 && return
  fi

  try_key $CONFIG_HOME/lift.yml .$1 && return

  err "$1 config cannot be resolved"
}

global_get_or() {
  key="${PREFIX:-}$1"

  try_key Liftfile .$key && return

  if [ -n "${PREFIX:-}" ]; then
    try_key Liftfile .$1 && return
  fi

  if [ -n "${DELEGATE_FILE:-}" ]; then
    try_key "$DELEGATE_FILE" .$1 && return
  fi

  try_key $CONFIG_HOME/lift.yml .$1 && return

  echo "$2"
}

cluster_get() {
  try_key "$CLUSTERFILE" .$1 && return

  err "$1: no such key in Clusterfile"
}

cluster_get_or() {
  try_key "$CLUSTERFILE" .$1 && return

  echo "$2"
}

node_get() {
  try_key "$CLUSTERFILE" ".runners.$1.$2" && return
  try_key "$CLUSTERFILE" ".nodes.$1.$2" && return

  err "$1: no $2 configured"
}

node_get_or() {
  try_key "$CLUSTERFILE" ".runners.$1.$2" && return
  try_key "$CLUSTERFILE" ".nodes.$1.$2" && return

  echo "$3"
}

# Cluster discovery

cluster() {
  if [ -n "${LIFT_CLUSTER:-}" ]; then
    echo "$LIFT_CLUSTER"
    return
  fi

  try_key Liftfile .cluster && return
  try_key "$CONFIG_HOME/lift.yml" .default && return

  if ! clusters=$(try_key "$CONFIG_HOME/lift.yml" '.clusters[] | key'); then
    err "no clusters configured"
  fi

  if [ "$(echo "$clusters" | wc -l)" -ne 1 ]; then
    err "no default cluster, use -c"
  fi

  echo "$clusters"
}

srv() {
  if has dig; then
    dig +short SRV "_lift._tcp.$1"
  elif has drill; then
    drill SRV "_lift._tcp.$1" | awk '$4 == "SRV" { print $5, $6, $7, $8 }'
  else
    err "dig or drill is required for SRV lookups"
  fi | sort -k1,1n -k2,2nr | awk '{ sub(/\.$/, "", $4); print $4 }'
}

# Cluster helpers

nodes() {
  try_key "$CLUSTERFILE" '.runners[] | key' && return
  try_key "$CLUSTERFILE" '.nodes[] | key' && return

  err "Clusterfile: no runners"
}

default_node() {
  nodes=$(nodes)

  if [ "$(echo "$nodes" | wc -l)" -ne 1 ]; then
    err "cluster has several nodes"
  fi

  echo "$nodes"
}

is_node() {
  nodes | grep -qxF "$1"
}

# Shell helpers

squote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

# Path helpers

is_absolute() {
  case "$1" in
    /*) return 0 ;;
    *)  return 1 ;;
  esac
}

path_join() {
  local a="$1" b="$2"
  if [ -z "$a" ]; then
    echo "$b"
    return
  fi
  a="${a%/}"
  b="${b#/}"
  echo "$a/$b"
}

# Transport helpers

remote_keys() {
  ssh -v -o BatchMode=yes -o ConnectTimeout=5 -o PreferredAuthentications=none "$1" true 2>&1 \
    | awk '/Server host key:/{sub(/\r$/, ""); print $NF}'
}

own_keys() {
  for k in /etc/ssh/ssh_host_*_key.pub; do swallow ssh-keygen -lf "$k"; done \
    | awk '{print $2}'
}

is_self() {
  grep -qxFf <(own_keys) <(remote_keys "$1")
}

declare -A seen

is_local() {
  [ "$1" = 'local' ] && return 0

  if [ -z "${seen[$1]+_}" ]; then
    is_self "$1" && seen[$1]=1 || seen[$1]=0
  fi

  [ "${seen[$1]}" = 1 ]
}

is_same() {
  [ "$1" = "$2" ] || { is_local "$1" && is_local "$2"; }
}

is_reachable() {
  is_local "$1" || quiet ssh -o ConnectTimeout=5 "$1" true
}

on() {
  if is_local "$1"; then
    bash -l -c "$2" lift
  else
    tty=-T
    [ -t 0 ] && [ -t 1 ] && tty=-t
    ssh -o LogLevel=ERROR -o ConnectTimeout=10 "$tty" "$1" "bash -l -c $(squote "$2") lift"
  fi
}

with() {
  if is_local "$1"; then
    "${@:2}"
  else
    DOCKER_HOST="ssh://$1" "${@:2}"
  fi
}

each() {
  failed=()

  for node in $1; do
    set +e
    ( set -e; "$2" "$node" "${@:3}" )
    rc=$?
    set -e

    [ $rc -eq 0 ] || failed+=("$node")
  done

  [ ${#failed[@]} -eq 0 ] || err "failed on ${failed[*]}"
}

# Runtime code

target() {
  case $MODE in
    probe)
      echo "$1 $NODE"
      ;;

    dispatch)
      echo "==> Starting $1"
      docker start "$1" >/dev/null
      ;;

    provision)
      if [[ ${wanted[$1]+_} ]]; then
        echo "==> Recreating $1"
        quiet docker stop "$1" || true
        quiet docker rm -f "$1" || true
        return 0
      fi
      ;;
  esac

  return 1
}

containers() {
  source /etc/lift/cluster.env

  for f in /etc/lift/containers.d/*; do
    source "$f"
  done
}

orphans() {
  MODE=probe

  docker ps -a --format '{{.Names}}' \
    | { grep -vxFf <(containers | cut -d' ' -f1) || true; } \
    | while read -r c; do warn "container $c is not declared"; done
}

initialize() {
  if ! has docker; then
    err "docker not installed"
  fi

  if [ -f /etc/synoinfo.conf ]; then
    if ! quiet sudo synogroup --get docker; then
      quiet sudo synogroup --add docker
      echo "Created group docker."
    fi

    if ! sudo synogroup --get docker | grep "$USER" >/dev/null 2>&1; then
      quiet sudo synogroup --memberadd docker $USER
      echo "Added $USER to group docker."
    fi
  else
    if ! grep -q '^docker:' /etc/group; then
      quiet sudo groupadd docker
      echo "Created group docker."
    fi

    if ! id -nG "$USER" | tr ' ' '\n' | grep -qx docker; then
      quiet sudo usermod -aG docker $USER || err "could not add user to docker group"
      echo "Added $USER to group docker."
    fi

    if [ -d /run/systemd/system ]; then
      sudo systemctl enable --now docker.service
    fi
  fi

  if [ -z "$(find /var/run/docker.sock -user root -group docker)" ]; then
    sudo chown root:docker /var/run/docker.sock || err "could not change socket ownership"
    echo "Assigned docker socket ownership."
  fi

  if [ ! -d /etc/lift/containers.d ]; then
    sudo mkdir -p /etc/lift/containers.d
    sudo chown root:docker /etc/lift /etc/lift/containers.d
    sudo chmod 2775 /etc/lift /etc/lift/containers.d
    echo "Created lift containers.d filesystem."
  fi

  if ! quiet sudo docker network inspect "$1"; then
    quiet sudo docker network create -d bridge ${2:+--subnet "$2"} "$1"
    echo "Created network $1."
  fi

  subnet=$(sudo docker network inspect -f '{{(index .IPAM.Config 0).Subnet}}' "$1")

  if [ -n "$2" ] && [ "$subnet" != "$2" ]; then
    warn "network $1 has subnet $subnet instead of $2"
  fi
}

prelude() {
  echo 'set -euo pipefail'

  cat <<-'EOF'
		quiet() { "$@" >/dev/null 2>&1; }
		has() { command -v "$1" >/dev/null 2>&1; }
		err() { echo >&2 "lift: $1"; exit 1; }
		warn() { echo >&2 "lift: warning: $1"; }
	EOF

  declare -f target containers orphans initialize
}

payload() {
  prelude

  printf 'MODE=%q\n' "$1"
  printf 'declare -A wanted=('
  [ $# -gt 1 ] && printf '[%q]=1 ' "${@:2}"
  echo ')'

  echo containers
}

run_on() {
  on "$(node_get "$1" host)" "$(payload "${@:2}")"
}

# Public API

alias() {
  if [ -f "$CONFIG_HOME/lift.yml" ] && has_key "$CONFIG_HOME/lift.yml" ".aliases.$1"; then
    yq ".aliases.$1" "$CONFIG_HOME/lift.yml"; return 0
  fi

  return 1
}

setup() {
  [ $# -eq 1 ] || err "missing host"

  host="$1"
  node="${host#*@}"
  node="${node%%.*}"

  clusterfile=$(cat <<-EOF
	net: $NET
	runners:
	  $node:
	    host: $host
	    base: /srv/www
	EOF
  )

  env=$(cat <<-EOF
	NODE=$node
	NODES=$node
	NET=$NET
	EOF
  )

  echo "==> Setting up $node"

  on "$host" "$(
    prelude
    printf 'initialize %q ""\n' "$NET"
  )"

  on "$host" "$(
    prelude
    echo 'umask 002'
    echo 'if [ -e /etc/lift/cluster.yml ]; then echo "Already part of a cluster."; exit 0; fi'
    printf 'printf "%%s\\n" %q > /etc/lift/cluster.yml\n' "$clusterfile"
    printf 'printf "%%s\\n" %q > /etc/lift/cluster.env\n' "$env"
    echo 'echo "Created single-node cluster."'
  )"
}

apply() {
  [ -f Clusterfile ] || err "no Clusterfile found"

  if [ -n "$(git status --porcelain)" ]; then
    err "uncommitted changes, commit them first"
  fi

  rev=$(git rev-parse HEAD)

  quiet yq . Clusterfile || err "Clusterfile: syntax error"

  CLUSTERFILE=Clusterfile

  [ -n "$(nodes)" ] || err "Clusterfile: no runners"

  for node in $(nodes); do
    [ -f "containers.d/$node" ] || err "no containers.d/$node found"
    bash -n "containers.d/$node" || err "containers.d/$node: syntax error"
  done

  each "$(nodes | xargs)" apply_on "$rev"
}

apply_on() {
  echo "==> Applying ${2:0:12} to $1"

  host=$(node_get "$1" host)
  net=$(cluster_get_or net "$NET")

  env=$(printf 'NODE=%q\nNODES=%q\nNET=%q\n' "$1" "$(nodes | xargs)" "$net")

  # These are separate connections on purpose, so the second command
  # has fresh docker group membership.

  on "$host" "$(
    prelude
    printf 'initialize %q %q\n' "$net" "$(node_get_or "$1" subnet '')"
  )"

  on "$host" "$(
    prelude
    echo 'umask 002'
    printf 'printf "%%s\\n" %q > /etc/lift/cluster.yml\n' "$(cat "$CLUSTERFILE")"
    printf 'printf "%%s\\n" %q > /etc/lift/cluster.env\n' "$env"
    printf 'printf "%%s\\n" %q > /etc/lift/cluster.rev\n' "$2"
    printf 'printf "%%s\\n" %q > /etc/lift/containers.d/00-cluster\n' "$(cat "containers.d/$1")"
    echo 'MODE=dispatch'
    echo containers
    echo orphans
  )"
}

status() {
  head=''

  if [ -f Clusterfile ]; then
    head=$(git rev-parse HEAD)
  fi

  revs=()
  unreachable=()

  printf '%-16s %s\n' NODE REV

  for node in $(nodes); do
    host=$(node_get "$node" host)

    if rev=$(on "$host" 'cat /etc/lift/cluster.rev 2>/dev/null || echo none' 2>/dev/null); then
      revs+=("$rev")
      printf '%-16s %s\n' "$node" "${rev:0:12}"
    else
      unreachable+=("$node")
      printf '%-16s %s\n' "$node" unreachable
    fi
  done

  distinct=$(printf '%s\n' "${revs[@]}" | sort -u)

  if [ "$(echo "$distinct" | wc -l)" -gt 1 ]; then
    warn "nodes run different revisions"
  fi

  if [ -n "$head" ] && [ -n "$distinct" ] && [ "$distinct" != "$head" ]; then
    warn "nodes differ from local HEAD (${head:0:12})"
  fi

  if [ ${#unreachable[@]} -gt 0 ]; then
    warn "unreachable: ${unreachable[*]}"
  fi
}

where() {
  table=$(
    for node in $(nodes); do
      run_on "$node" probe || warn "$node: unreachable, placement unknown"
    done
  )

  if [ $# -gt 0 ]; then
    echo "$table" | awk -v n="$1" '$1 == n { print $2 }' | sort -u | xargs
    return
  fi

  echo "$table" | sort | uniq -d | while read -r name node; do
    warn "$name is declared more than once on $node, the last declaration wins"
  done

  { echo "NAME NODE"; echo "$table" | sort -u; } | column -t
}

dispatch() {
  each "$(nodes | xargs)" run_on dispatch
}

provision() {
  [ $# -gt 0 ] || err "missing container name"

  targets=''

  for name in "$@"; do
    found=$(where "$name")

    if [ -z "$found" ]; then
      err "$name: not declared on any reachable node"
    fi

    targets="$targets $found"
  done

  each "$(printf '%s\n' $targets | sort -u | xargs)" run_on provision "$@"
}

deploy() {
  DRY_RUN=0
  YES=0
  FORCE=0
  SERVICE=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -n) DRY_RUN=1; shift ;;
      -y) YES=1; shift ;;
      -f) FORCE=1; shift ;;
      *) SERVICE="$1"; shift ;;
    esac
  done

  if [ ! -e "./Liftfile" ]; then
    err "no Liftfile found"
  fi

  service="${SERVICE%@*}"
  selected="${SERVICE#"$service"}"
  selected="${selected#@}"

  if [ -n "$selected" ] && ! is_node "$selected"; then
    err "$selected: no such node"
  fi

  if [ -f Liftfile ] && has_key Liftfile .services; then
    count=$(yq '.services | length' Liftfile)
    found=0

    for ((i=0; i<count; i++)); do
      if [ -z "$service" ] || [ "$(yq ".services[$i].name" Liftfile)" = "$service" ]; then
        do_deploy ".services[$i]." "$selected"
        found=1
      fi
    done

    [ -z "$service" ] || [ $found -eq 1 ] || err "$service: no such service"
  else
    do_deploy "." "$selected"
  fi
}

do_deploy() {
  export PREFIX="${1#.}"; PREFIX="${PREFIX%.}"
  [ -n "$PREFIX" ] && PREFIX="${PREFIX}."

  DELEGATE_FILE=""
  if has_key Liftfile .${PREFIX}delegate; then
    DELEGATE_FILE=$(yq .${PREFIX}delegate Liftfile)

    [ -d "$DELEGATE_FILE" ] && DELEGATE_FILE="$DELEGATE_FILE/Liftfile"
    [ -f "$DELEGATE_FILE" ] || err "$DELEGATE_FILE: no such file"
  fi

  name=$(get name)
  type=$(get_or type container)

  for key in runner push provision restart; do
    if [ -n "$(get_or "$key" '')" ]; then
      err "$name: '$key' is no longer supported"
    fi
  done

  targets="${2:-$(nodes | xargs)}"

  case $type in
    container)
      image=$(get image)

      mirrors=$(get_or registry '')
      [ -n "$mirrors" ] || mirrors=$(cluster_get_or registry '')

      registries=()

      if [ -n "$mirrors" ]; then
        readarray -t registries < <(
          printf '%s\n' "$mirrors" |
            yq 'select(tag != "!!seq"), (select(tag == "!!seq") | .[])'
        )
      fi

      targets=$(where "$name")

      if [ -z "$targets" ]; then
        err "$name: not declared on any reachable node"
      fi

      if [ -n "$2" ]; then
        if [[ " $targets " != *" $2 "* ]]; then
          err "$name: not declared on $2"
        fi

        targets="$2"
      fi

      builders=$(cluster_get_or 'builders[]' '')

      if [ -z "$builders" ]; then
        node=$(default_node)
        builders=$(node_get "$node" host)
      fi

      builder=''

      for b in $builders; do
        if is_reachable "$b"; then
          builder="$b"
          break
        fi
      done

      if [ -z "$builder" ]; then
        err "no reachable builder"
      fi

      if [ ${#registries[@]} -eq 0 ]; then
        for node in $targets; do
          if ! is_same "$(node_get "$node" host)" "$builder"; then
            err "$name: no registry configured, cannot ship from $builder to $node"
          fi
        done
      fi

      tags=()
      args=()

      for registry in "${registries[@]}"; do
        tags+=("$registry/$image")
      done

      [ ${#tags[@]} -gt 0 ] || tags=("$image")
      tag="${tags[0]}"

      if [ $DRY_RUN -eq 1 ]; then
        echo "==> Building $name on $builder (DRY RUN)"
      else
        echo "==> Building $name on $builder (as $tag)"
      fi

      if [ $DRY_RUN -eq 0 ]; then
        for build_tag in "${tags[@]}"; do
          args+=(-t "$build_tag")
        done
      fi

      buildroot="${DELEGATE_FILE:+$(dirname "$DELEGATE_FILE")}"

      [ -n "$buildroot" ] && pushd "$buildroot" >/dev/null
      with "$builder" docker build "${args[@]}" .
      [ -n "$buildroot" ] && popd >/dev/null

      if [ $DRY_RUN -eq 1 ]; then
        echo "==> Dry run, skipping push and provision"
      else
        for registry in "${registries[@]}"; do
          echo "==> Pushing $name to $registry/$image"
          with "$builder" docker push "$registry/$image"
        done

        each "$targets" deploy_on "$name" "$tag" "$builder"
      fi
      ;;

    static)
      src=$(get_or src "$name")
      dest=$(get_or target "$name")

      label="$name"
      [ $DRY_RUN -eq 1 ] && label="$name (DRY RUN)"

      flags=(-ciavuP --no-times)
      [ $DRY_RUN -eq 1 ] && flags+=(-n)

      excludes=()
      rsync_sources=()

      if [ -f "$src" ]; then
        rsync_sources=("$src")
      elif [ -d "$src" ]; then
        skips=("Liftfile" "Bakefile" ".git" ".gitignore" ".gitattributes" ".gitmodules" ".vscode" ".claude" ".DS_Store")

        if has_key Liftfile .${PREFIX}exclude; then
          readarray -t extra_skips < <(yq ".${PREFIX}exclude[]" Liftfile)
          skips+=("${extra_skips[@]}")
        fi

        for e in "${skips[@]}"; do
          excludes+=(--exclude "$e")
        done

        if [ "$(get_or delete true)" = "true" ]; then
          flags+=(--delete)
        fi

        rsync_sources=("$src/.")
      else
        readarray -t rsync_sources < <(compgen -G "$src")
        [ ${#rsync_sources[@]} -gt 0 ] || err "$src: no matches"
      fi

      rsync_mode=$(global_get_or rsync "approval")

      [ $YES -eq 1 ] && rsync_mode="immediate"
      [ $FORCE -eq 1 ] && rsync_mode="force"

      failed=()
      approved=()

      for node in $targets; do
        echo "==> Copying $label to $node"

        path="$dest"

        if ! is_absolute "$path"; then
          base=$(node_get_or "$node" base '')

          if [ -z "$base" ]; then
            warn "$node: no base configured for relative target '$path'"
            failed+=("$node")
            continue
          fi

          path=$(path_join "$base" "$path")
        fi

        host=$(node_get "$node" host)

        if ! is_local "$host"; then
          path="$host:$path"
        fi

        if [ "$rsync_mode" != "force" ]; then
          preview=$(rsync -n "${flags[@]}" "${excludes[@]}" "${rsync_sources[@]}" "$path" 2>&1 | grep -Ev '^$|^sending incremental file list|^sent [0-9]|^total size |^\.[fd]\.\.t' || true)

          if [ -z "$preview" ]; then
            echo "nothing to sync"
            echo
            continue
          fi
        fi

        if [ $DRY_RUN -eq 0 ] && [ "$rsync_mode" = "approval" ]; then
          known=0

          for previous in "${approved[@]}"; do
            if [ "$previous" = "$preview" ]; then
              known=1
            fi
          done

          if [ $known -eq 1 ]; then
            echo "same changes as approved before"
          else
            echo "$preview"
            echo

            if ! prompt -n "Proceed?"; then
              echo "Skipped."
              echo
              continue
            fi

            approved+=("$preview")
          fi
        fi

        if ! rsync "${flags[@]}" "${excludes[@]}" "${rsync_sources[@]}" "$path"; then
          failed+=("$node")
        fi
      done

      if [ ${#failed[@]} -gt 0 ]; then
        err "failed on ${failed[*]}"
      fi
      ;;
    *)
      err "unknown deployment type '$type'"
      ;;
  esac
}

deploy_on() {
  host=$(node_get "$1" host)

  if ! is_same "$host" "$4"; then
    echo "==> Pulling $2 on $1"
    with "$host" docker pull "$3"
  fi

  run_on "$1" provision "$2"
}

while [ $# -gt 0 ]; do
  case "$1" in
    -c|--cluster)
      if [ -z "${2:-}" ]; then
        err "$1: missing cluster name"
      fi

      LIFT_CLUSTER="$2"
      shift 2
      ;;
    *) break ;;
  esac
done

# Try to resolve aliases first, before starting main execution.
if [ -n "${1:-}" ] && expansion=$(alias "${1%@*}" 2>/dev/null); then
  at="${1#"${1%@*}"}"
  eval "set -- $expansion ${@:2}"
  set -- "$1$at" "${@:2}"
fi

case ${1:-} in
  ""|-h|--help) usage ;;
  setup) setup "${@:2}"; exit ;;
  apply) apply; exit ;;
  launch) err "not yet implemented" ;;
  status|where|dispatch|provision|deploy|docker|docker@*) ;;
  *) err "unknown subcommand '$1'" ;;
esac

# TODO: clean up this mess

name=$(cluster)
export name

tag='!!null'

if [ -f "$CONFIG_HOME/lift.yml" ]; then
  tag=$(yq '.clusters[strenv(name)] | tag' "$CONFIG_HOME/lift.yml")
fi

case $tag in
  '!!seq') hosts=$(yq '.clusters[strenv(name)][]' "$CONFIG_HOME/lift.yml") ;;
  '!!null') hosts=$(srv "$name" 2>/dev/null || true); hosts="${hosts:-$name}" ;;
  *) hosts=$(srv "$(yq '.clusters[strenv(name)]' "$CONFIG_HOME/lift.yml")") ;;
esac

CLUSTERFILE=$(mktemp)
trap 'rm -f -- "$CLUSTERFILE"' EXIT

bare=''

for host in $hosts; do
  if on "$host" 'cat /etc/lift/cluster.yml 2>/dev/null || true' > "$CLUSTERFILE"; then
    [ -s "$CLUSTERFILE" ] && break
    bare="$host"
  fi
done

if [ ! -s "$CLUSTERFILE" ]; then
  [ -z "$bare" ] || err "$bare: not set up, run 'lift setup $bare'"
  err "$name: no reachable entry point"
fi

case $1 in
  status) status ;;
  where) where "${@:2}" ;;
  dispatch) dispatch ;;
  provision) provision "${@:2}" ;;
  deploy) deploy "${@:2}" ;;
  docker)
    node=$(default_node)
    host=$(node_get "$node" host)
    with "$host" docker "${@:2}"
    ;;
  docker@*)
    is_node "${1#docker@}" || err "${1#docker@}: no such node"
    host=$(node_get "${1#docker@}" host)
    with "$host" docker "${@:2}"
    ;;
esac
