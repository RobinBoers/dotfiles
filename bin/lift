#!/usr/bin/env bash
# Remote deployment manager for containers and static files.

set -euo pipefail

export TERM=xterm

required yq
required quiet
required has
required swallow

NET=punctual

# Attempts to detect configuration directory on the current platform. This
# is probabily insufficient for Windows, but I doubt this is gonna work anyway.
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

usage() {
  echo "Usage: $(basename "$0") [opts] <subcommand> [args]"
  echo
  echo "OPTIONS"
  echo "  -h, --help     Show this help."
  echo
  echo "GENERAL COMMANDS"
  echo "  setup          Sets up docker permissions and networking for remote builds."
  echo "  use            Temporarily changes the default runner for the current session."
  echo "  docker         Executes docker commands on the default runner."
  echo "  dispatch       Ensures all containers are up on the default runner."
  echo "  provision      Recreates the given docker container(s) on the default runner."
  echo "  edit           Edits bootstrap definitions on the default runner."
  echo
  echo "The default runner can be configured in $(echo $CONFIG_HOME | sed "s|^$HOME/||")/lift.yml"
  echo
  echo "For directories containing a Liftfile, the runner configured in the Liftfile will be used"
  echo "as runner instead. 'lift use' always overrides both Liftfile and lift.yml"
  echo
  echo "PROJECT COMMANDS"
  echo "  launch         Interactively creates Liftfile and updates bootstrap definitions."
  echo "  deploy         Remotely builds the image, pushes it to the registry and bumps the container."
  echo
  exit 0
}

# YAML helpers

has_key() {
  out=$(yq "$2" "$1")
  [ -n "$out" ] && [ ! "$out" = "null" ]
}

try_key() {
  if [ -f "$1" ] && has_key "$1" "$2"; then
    yq "$2" "$1"
  else
    return 1
  fi
}

# Config helpers

get() {
  key="${PREFIX:-}$1"

  try_key Liftfile .$key && return

  if [ -n "${PREFIX:-}" ]; then
    try_key Liftfile .$1 && return
  fi

  if [ -n "${DELEGATE_FILE:-}" ]; then
    try_key "$DELEGATE_FILE" .$1 && return
  fi

  err "$1: no such key in Liftfile"
}

get_or() {
  key="${PREFIX:-}$1"

  if has_key Liftfile .$key; then
    yq .$key Liftfile
  elif [ -n "${PREFIX:-}" ] && has_key Liftfile .$1; then
    yq .$1 Liftfile
  elif [ -n "${DELEGATE_FILE:-}" ] && has_key "$DELEGATE_FILE" .$1; then
    yq .$1 "$DELEGATE_FILE"
  else
    echo "$2"
  fi
}

global_get() {
  h="$(get runner)"
  key="${PREFIX:-}$1"

  try_key Liftfile .$key && return

  if [ -n "${PREFIX:-}" ]; then
    try_key Liftfile .$1 && return
  fi

  if [ -n "${DELEGATE_FILE:-}" ]; then
    try_key "$DELEGATE_FILE" .$1 && return
  fi

  try_key $CONFIG_HOME/lift.yml .hosts.$h.$1 && return
  try_key $CONFIG_HOME/lift.yml .$1 && return

  err "$1 config cannot be resolved"
}

global_get_or() {
  h="$(get runner)"
  key="${PREFIX:-}$1"

  try_key Liftfile .$key && return

  if [ -n "${PREFIX:-}" ]; then
    try_key Liftfile .$1 && return
  fi

  if [ -n "${DELEGATE_FILE:-}" ]; then
    try_key "$DELEGATE_FILE" .$1 && return
  fi

  try_key $CONFIG_HOME/lift.yml .hosts.$h.$1 && return
  try_key $CONFIG_HOME/lift.yml .$1 && return

  echo "$2"
}

# Shell helpers

squote() {
  printf "'%s'" "${1//\'/\'\\\'\'}"
}

# Path helpers

is_absolute() {
  case "$1" in
    /*) return 0 ;;
    *)  return 1 ;;
  esac
}

path_join() {
  local a="$1" b="$2"
  if [ -z "$a" ]; then
    echo "$b"
    return
  fi
  a="${a%/}"
  b="${b#/}"
  echo "$a/$b"
}

# Transport helpers

remote_keys() {
  ssh -v -o BatchMode=yes -o PreferredAuthentications=none "$1" true 2>&1 \
    | awk '/Server host key:/{print $NF}' | sort
}

own_keys() {
  for k in /etc/ssh/ssh_host_*_key.pub; do swallow ssh-keygen -lf "$k"; done \
    | awk '{print $2}' | sort
}

is_self() {
  comm -12 <(remote_keys "$1") <(own_keys) | grep -q .
}

declare -A seen

is_local() {
  [ "$1" = 'local' ] && return 0

  if [ -z "${seen[$1]+_}" ]; then
    is_self "$1" && seen[$1]=1 || seen[$1]=0
  fi

  [ "${seen[$1]}" = 1 ]
}

on() {
  if is_local "$1"; then
    bash -l -c "$2" lift
  else
    ssh "$([ -t 0 ] && echo -t || echo -T)" "$1" "bash -l -c $(squote "$2") lift"
  fi
}

with() {
  if is_local "$1"; then
    "${@:2}"
  else
    DOCKER_HOST="ssh://$1" "${@:2}"
  fi
}

# Runtime code

BOOTSTRAP=$(cat <<'EOF'
#!/usr/bin/env bash

if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  # Script is being sourced, do nothing.
  :
else
  echo "Warning: This script provides bootstrap definitions for 'lift', and is not"
  echo "intended to be executed directly. Instead, use 'lift provision'."
  echo
  exit 1
fi

# Secrets live on the runner. Load them here, before any definitions. The
# variable $NET defaults to the shared Lift network, but may be overridden.

# source /volume1/docker/.env
# NET=punctual

# This file is used to provision docker containers. The `target` command
# indicates whether the given docker container is scheduled for provisioning:

# if target your-container; then
#   docker run -dit --name master-db \
#     --net $NET --restart always \
#     -v /volume1/docker/postgres:/var/lib/postgresql/data:rw \
#     -e 'PG_DATA=/var/lib/postgresql/data' \
#     -e "POSTGRES_USER=$DB_USER" \
#     -e "POSTGRES_PASSWORD=$DB_PASS" \
#     postgres:17
# fi

# The variable $NET may be used to attach docker containers to the shared
# Lift network, allowing them to communicate: `docker run ... --net $NET`

# It is ESSENTIAL that the target name EXACTLY matches the container name.
EOF
)

target() {
  if [[ $MODE == "dispatch" ]]; then
    echo "==> Starting $1"
    docker start "$1" >/dev/null

    return 1
  else
    if [[ ${wanted[$1]+_} ]]; then
      echo "==> Recreating $1"
      quiet docker stop "$1" || true
      quiet docker rm -f "$1" || true
      return 0
    else
      return 1
    fi
  fi
}

bootstrap() {
  source lift-bootstrap
}

initialize() {
  if ! has docker; then
    err "docker not installed"
  fi

  if [ -f /etc/synoinfo.conf ]; then
    if ! quiet sudo synogroup --get docker; then
      quiet sudo synogroup --add docker
    fi

    if ! sudo synogroup --get docker | grep "$USER" >/dev/null 2>&1; then
      quiet sudo synogroup --memberadd docker $USER
    fi
  else
    quiet sudo groupadd docker || true
    quiet sudo usermod -aG docker $USER || err "could not add user to docker group"
    echo "if this is your first time running this, run 'newgrp docker'"

    if [ -d /run/systemd/system ]; then
      sudo systemctl enable --now docker.service
    fi
  fi

  sudo chown root:docker /var/run/docker.sock || err "could not change socker ownership"
  echo "Enabled rootless docker access for $USER."

  BOOTSTRAP_PATH=/usr/local/bin/lift-bootstrap

  if ! has lift-bootstrap; then
    if [ -e "$BOOTSTRAP_PATH" ]; then
      err "'$BOOTSTRAP_PATH' exists, but is not in PATH."
    fi

    echo "$BOOTSTRAP" | quiet sudo tee "$BOOTSTRAP_PATH"
    sudo chown root:docker "$BOOTSTRAP_PATH"
    sudo chmod 775 "$BOOTSTRAP_PATH"

    echo "Initial bootstrap definitions written to '$BOOTSTRAP_PATH'"
  fi

  source $BOOTSTRAP_PATH # Find $NET override if set.

  if ! quiet sudo docker network inspect "$NET"; then
    quiet sudo docker network create -d bridge "$NET"
    echo "Successfully created and configured network."
  fi

  echo "You're all set."
}

payload() {
  echo 'set -euo pipefail'

  cat <<-'EOF'
		quiet() { "$@" >/dev/null 2>&1; }
		has() { command -v "$1" >/dev/null 2>&1; }
		err() { echo >&2 "lift: $1"; exit 1; }
	EOF

  declare -p NET BOOTSTRAP
  declare -f target bootstrap initialize

  printf 'MODE=%q\n' "$1"
  printf 'declare -A wanted=('
  [ $# -gt 1 ] && printf '[%q]=1 ' "${@:2}"
  echo ')'

  case "$1" in
    initialize) echo initialize ;;
    *) echo bootstrap ;;
  esac
}

# Public API

has_services() {
  [ -f Liftfile ] && has_key Liftfile .services
}

runner() {
  if [ -n "${LIFT_HOST:-}" ]; then
    echo "$LIFT_HOST"
  else
    if [ -f Liftfile ]; then
      if has_services; then
        try_key Liftfile '.services[0].runner' \
          || try_key Liftfile .runner \
          || err "no runner configured in Liftfile"
      else
        try_key Liftfile .runner \
          || err "no runner configured in Liftfile"
      fi
    else
      try_key "$CONFIG_HOME/lift.yml" .runner \
        || echo 'local'
    fi
  fi
}

alias() {
  if [ -f "$CONFIG_HOME/lift.yml" ] && has_key "$CONFIG_HOME/lift.yml" ".aliases.$1"; then
    yq ".aliases.$1" "$CONFIG_HOME/lift.yml"; return 0
  fi

  return 1
}

setup() {
  [ -z "${1:-}" ] && err "missing runner"
  on "$1" "$(payload initialize)"
}

deploy() {
  DRY_RUN=0
  YES=0
  FORCE=0
  SERVICE=""

  while [ $# -gt 0 ]; do
    case "$1" in
      -n) DRY_RUN=1; shift ;;
      -y) YES=1; shift ;;
      -f) FORCE=1; shift ;;
      *) SERVICE="$1"; shift ;;
    esac
  done

  if [ ! -e "./Liftfile" ]; then
    err "no Liftfile found"
  fi

  if has_services; then
    local count=$(yq '.services | length' Liftfile)

    if [ -n "$SERVICE" ]; then
      local SERVICE_NAME="${SERVICE%@*}"
      local SERVICE_RUNNER="${SERVICE#*@}"
      [ "$SERVICE_RUNNER" = "$SERVICE_NAME" ] && SERVICE_RUNNER=""

      local found=0

      for ((i=0; i<count; i++)); do
        if [ "$(yq ".services[$i].name" Liftfile)" = "$SERVICE_NAME" ]; then
          if [ -z "$SERVICE_RUNNER" ] || [ "$(yq ".services[$i].runner" Liftfile)" = "$SERVICE_RUNNER" ]; then
            do_deploy ".services[$i]."
            found=1
          fi
        fi
      done

      if [ $found -eq 0 ]; then
        if [ -n "$SERVICE_RUNNER" ]; then
          err "$SERVICE_NAME: no such service for runner '$SERVICE_RUNNER'"
        else
          err "$SERVICE: no such service"
        fi
      fi
    else
      for ((i=0; i<count; i++)); do
        do_deploy ".services[$i]."
      done
    fi
  else
    do_deploy "."
  fi
}

do_deploy() {
  export PREFIX="${1#.}"; PREFIX="${PREFIX%.}"
  [ -n "$PREFIX" ] && PREFIX="${PREFIX}."

  DELEGATE_FILE=""
  if has_key Liftfile .${PREFIX}delegate; then
    DELEGATE_FILE=$(yq .${PREFIX}delegate Liftfile)

    [ -d "$DELEGATE_FILE" ] && DELEGATE_FILE="$DELEGATE_FILE/Liftfile"
    [ -f "$DELEGATE_FILE" ] || err "$DELEGATE_FILE: no such file"
  fi

  name=$(get name)
  type=$(get_or type container)

  runner=$(get runner)
  builder=$(global_get_or builder "$runner")
  push=$(global_get_or push "true")

  if [ "$type" = "container" ] && [ "$runner" != "$builder" ] && [ "$push" != "true" ]; then
    err "push cannot be disabled when builder ('$builder') differs from runner ('$runner')"
  fi

  case $type in
    container)
      image=$(get image)
      mirrors=$(global_get registry)

      readarray -t registries < <(
        printf '%s\n' "$mirrors" |
          yq 'select(tag != "!!seq"), (select(tag == "!!seq") | .[])'
      )

      if ! [ ${#registries[@]} -gt 0 ]; then
        err "registry cannot be resolved"
      fi

      tags=()
      args=()

      for registry in "${registries[@]}"; do
        tags+=("$registry/$image")
      done

      registry="${registries[0]}"
      tag="${tags[0]}"

      if [ $DRY_RUN -eq 1 ]; then
        echo "==> Building $name on $builder (DRY RUN)"
      else
        echo "==> Building $name on $builder (as $tag)"
      fi

      if [ $DRY_RUN -eq 0 ]; then
        for build_tag in "${tags[@]}"; do
          args+=(-t "$build_tag")
        done
      fi

      buildroot="${DELEGATE_FILE:+$(dirname "$DELEGATE_FILE")}"
  
      [ -n "$buildroot" ] && pushd "$buildroot" >/dev/null
      with "$builder" docker build "${args[@]}" .
      [ -n "$buildroot" ] && popd >/dev/null

      if [ $DRY_RUN -eq 1 ]; then
        echo "==> Dry run, skipping push and provision"
      else
        if [ "$push" = "true" ]; then
          for push_tag in "${tags[@]}"; do
            echo "==> Pushing $name to $push_tag"
            with "$builder" docker push "$push_tag"
          done

          if [ "$runner" != "$builder" ]; then
            echo "==> Pulling $name on $runner"
            with "$runner" docker pull "$tag"
          fi
        fi
        on "$runner" "$(payload provision "$name")"
      fi
      ;;
    static)
      src=$(get_or src "$name")
      dest=$(get_or target "$name")
      base=$(global_get_or base "")

      if ! is_absolute "$dest" && [ -n "$base" ]; then
        dest="$(path_join "$base" "$dest")"
      fi

      if [ $DRY_RUN -eq 1 ]; then
        echo "==> Copying $name (DRY RUN)"
      else
        echo "==> Copying $name"
      fi

      flags=(-ciavuP --no-times)
      [ $DRY_RUN -eq 1 ] && flags+=(-n)

      excludes=()
      rsync_sources=()

      if [ -f "$src" ]; then
        rsync_sources=("$src")
      elif [ -d "$src" ]; then
        skips=("Liftfile" "Bakefile" ".git" ".gitignore" ".gitattributes" ".gitmodules" ".vscode" ".claude" ".DS_Store")

        if has_key Liftfile .${PREFIX}exclude; then
          readarray -t extra_skips < <(yq ".${PREFIX}exclude[]" Liftfile)
          skips+=("${extra_skips[@]}")
        fi

        for e in "${skips[@]}"; do
          excludes+=(--exclude "$e")
        done

        if [ "$(get_or delete true)" = "true" ]; then
          flags+=(--delete)
        fi

        rsync_sources=("$src/.")
      else
        readarray -t rsync_sources < <(compgen -G "$src")
        [ ${#rsync_sources[@]} -gt 0 ] || err "$src: no matches"
      fi

      rsync_mode=$(global_get_or rsync "approval")

      [ $YES -eq 1 ] && rsync_mode="immediate"
      [ $FORCE -eq 1 ] && rsync_mode="force"

      if is_local "$runner"; then
        rsync_dest="$dest"
      else
        rsync_dest="$runner:$dest"
      fi

      if [ "$rsync_mode" != "force" ]; then
        preview=$(rsync -n "${flags[@]}" "${excludes[@]}" "${rsync_sources[@]}" "$rsync_dest" 2>&1 | grep -Ev '^$|^sending incremental file list|^sent [0-9]|^total size |^\.[fd]\.\.t' || true)

        if [ -z "$preview" ]; then
          echo "nothing to sync"
          echo
          return 0
        fi
      fi

      if [ $DRY_RUN -eq 1 ] || [ "$rsync_mode" != "approval" ]; then
        rsync "${flags[@]}" "${excludes[@]}" "${rsync_sources[@]}" "$rsync_dest"
      else
        echo "$preview"
        echo

        if prompt -n "Proceed?"; then
          rsync "${flags[@]}" "${excludes[@]}" "${rsync_sources[@]}" "$rsync_dest"
        else
          echo "Aborted."
          echo
          return
        fi
      fi

      if [ $DRY_RUN -eq 0 ]; then
        maybe_provision_or_restart "$runner"
      fi
      ;;
    *)
      err "unknown deployment type '$type'"
      ;;
  esac
}

maybe_provision_or_restart() {
  local provision=() restart=()

  readarray -t provision < <(get_or provision '[]' | yq '.[]')
  readarray -t restart < <(get_or restart '[]' | yq '.[]')

  if [ ${#provision[@]} -gt 0 ]; then
    echo "==> Provisioning ${provision[*]}"
    on "$1" "$(payload provision "${provision[@]}")"
  fi

  if [ ${#restart[@]} -gt 0 ]; then
    echo "==> Restarting ${restart[*]}"
    with "$1" docker restart "${restart[@]}"
  fi
}

# Try to resolve aliases first, before starting main execution.
if [ -n "${1:-}" ] && expansion=$(alias "$1" 2>/dev/null); then
  eval "set -- $expansion ${@:2}"
fi

case ${1:-} in
  ""|-h|--help) usage ;;
  setup) setup "${@:2}" ;;
  docker) r=$(runner) && with "$r" docker "${@:2}" ;;
  dispatch) r=$(runner) && on "$r" "$(payload dispatch)" ;;
  provision) r=$(runner) && on "$r" "$(payload provision "${@:2}")" ;;
  edit) r=$(runner) && on "$r" '"${EDITOR:-vi}" "$(command -v lift-bootstrap)"' ;;
  launch) err "not yet implemented" ;;
  deploy) deploy "${@:2}" ;;
  *) err "unknown subcommand '$1'" ;;
esac
