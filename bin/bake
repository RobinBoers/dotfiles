#!/usr/bin/env bash
# Bash-based Makefile replacement.

set -eu

PATH="./node_modules/.bin:$PATH"

declare -A __bake_snapshot=()
declare -A __bake_heads=()

__bake_next_id=0

__bake_init_path() {
  local explicit=${BAKE_PATH:-}
  local prefix directory
  local -a directories

  BAKE_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/bake/layers${explicit:+:$explicit}"

  if prefix=$(brew --prefix 2>/dev/null); then
    BAKE_PATH+=":$prefix/share/bake/layers"
  fi

  IFS=: read -r -a directories <<< "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
  for directory in "${directories[@]}"; do
    BAKE_PATH+=":$directory/bake/layers"
  done
}

usage() {
  echo "Usage: $(basename "$0") <target> [args]"
  echo
  exit 0
}

help() {
  echo "Usage: $(basename "$0") <target> [args]"
  echo
  echo "TARGETS"

  compgen -A function \
    | grep -Ev '^(__bake_|p:|help$|usage$|use$|super$)' \
    | cat -n

  echo
  exit 0
}

__bake_snapshot_functions() {
  local name
  local -a names=( $(compgen -A function) )

  __bake_snapshot=()

  for name in "${names[@]}"; do
    __bake_snapshot[$name]=$(declare -f "$name")
  done
}

__bake_capture_function() {
  local name=$1
  local definition=$2
  local parent=${__bake_heads[$name]:-}
  local id=$((++__bake_next_id))

  definition=${definition/#$name /__bake_impl_$id }
  eval "$definition"

  eval "__bake_call_$id() {
    local __BAKE_FUNCTION='$name'
    local __BAKE_SUPER='${parent:+__bake_call_$parent}'
    local -a __BAKE_ARGS=( \"\$@\" )
    __bake_impl_$id \"\$@\"
  }"

  eval "$name() { __bake_call_$id \"\$@\"; }"
  __bake_heads[$name]=$id
}

__bake_capture_changes() {
  local name definition
  local -a names=( $(compgen -A function) )

  for name in "${names[@]}"; do
    definition=$(declare -f "$name")
    [ "${__bake_snapshot[$name]:-}" = "$definition" ] && continue

    case $name in
      __bake_*|help|usage|use|super) err "$1 defines reserved function $name" ;;
    esac

    __bake_capture_function "$name" "$definition"
  done
}

super() {
  [ -n "${__BAKE_SUPER:-}" ] || err "${__BAKE_FUNCTION:-super} has no super implementation"

  if [ "$#" -gt 0 ]; then
    "$__BAKE_SUPER" "$@"
  else
    "$__BAKE_SUPER" "${__BAKE_ARGS[@]}"
  fi
}

use() {
  [ "$#" -eq 1 ] || err "usage: use NAME"

  local __bake_name=$1
  local __bake_path= __bake_directory
  local -a __bake_directories

  case $__bake_name in
    ''|*[!A-Za-z0-9._-]*) err "invalid layer name: $__bake_name" ;;
  esac

  IFS=: read -r -a __bake_directories <<< "$BAKE_PATH"
  for __bake_directory in "${__bake_directories[@]}"; do
    if [ -f "$__bake_directory/$__bake_name" ]; then
      __bake_path=$__bake_directory/$__bake_name
      break
    fi
  done

  [ -n "$__bake_path" ] || err "no such layer: $__bake_name"

  __bake_capture_changes 'Bakefile'
  __bake_snapshot_functions
  source "$__bake_path"
  __bake_capture_changes "layer $__bake_name"
  __bake_snapshot_functions
}

__bake_init_path
__bake_snapshot_functions

if [ -e "./Bakefile" ]; then
  source ./Bakefile
  __bake_capture_changes 'Bakefile'
else
  case ${1:-} in
    -h|--help|help) usage ;;
  esac

  err "no Bakefile found"
fi

case ${1:-} in
  -h|--help|help)
    help
    ;;
  "")
    if help | grep "build" -q; then
      TARGET=build build
    else
      err "build: no such target"
    fi
    ;;
  *)
    if help | grep "$1" -q; then
      set -o pipefail
      TARGET=$1 ${@}
    else
      err "$1: no such target"
    fi
    ;;
esac
