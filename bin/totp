#!/bin/sh -eu
# Prints the current code for an otpauth://totp/ URI read from stdin.

required oathtool

[ "$#" -eq 0 ] || err 'usage: totp < uri'

IFS= read -r uri || [ -n "${uri:-}" ] || err 'expected a URI on stdin'

case $uri in
  otpauth://totp/*\?*) ;;
  *) err 'expected an otpauth://totp/ URI' ;;
esac

query="${uri#*\?}&"
secret=
digits=6
period=30
algorithm=SHA1

while [ -n "$query" ]; do
  param=${query%%&*}
  query=${query#*&}

  case $param in
    secret=*) secret=${param#*=} ;;
    digits=*) digits=${param#*=} ;;
    period=*) period=${param#*=} ;;
    algorithm=*) algorithm=${param#*=} ;;
  esac
done

[ -n "$secret" ] || err 'URI has no secret'

printf '%s\n' "$secret" | upper | oathtool --totp="$(upper "$algorithm")" -b -d "$digits" -s "${period}s" -
