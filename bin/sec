#!/usr/bin/env bash
# Amazing password manager, written in Bash.

set -euo pipefail

required gpg
required git

: "${SEC_DATA_HOME:=${XDG_DATA_HOME:-$HOME/.local/share}/sec}"
: "${SEC_CONFIG_HOME:=${XDG_CONFIG_HOME:-$HOME/.config}/sec}"

shopt -s inherit_errexit

umask "${SEC_UMASK:-077}"

# Store helpers

use-store() {
  dir=${1:-${SEC_STORE:-personal}}

  case $dir in
    */*) ;;
    *) dir=$SEC_DATA_HOME/$dir ;;
  esac

  if [ "${2:-}" == 'create' ]; then
    mkdir -p "$dir"
  fi

  if [ ! -d "$dir" ]; then
    err "no such store: $dir"
  fi

  SEC_STORE=$(cd "$dir" && pwd)

  # Prevent git from falling through to other repositories.
  export GIT_CEILING_DIRECTORIES=${SEC_STORE%/*}
}

list-store() (
  cd "$SEC_STORE" &&
    find . -path ./.git -prune -o -type f -name '*.gpg' -print |
    sed 's|^\./||; s|\.gpg$||' |
    LC_ALL=C sort
)

exists() {
  [ -f "$SEC_STORE/${1#./}.gpg" ]
}

sandbox() {
  [[ /$1/ != */../* ]] || err "$1 is outside the store"
}

# GPG helpers

encrypt() {
  recipients=()

  while IFS= read -r id; do
    [ -z "$id" ] || recipients+=(-r "$id")
  done < "$SEC_STORE/.gpg-id"

  mkdir -p "${1%/*}"
  gpg -eq --batch --yes --compress-algo=none --no-encrypt-to "${recipients[@]}" -o "$1.tmp"
  mv "$1.tmp" "$1"
}

decrypt() {
  gpg -dq "$1"
}

# Git helpers

commit() {
  [ -d "$SEC_STORE/.git" ] || return 0

  git -C "$SEC_STORE" add -A -- "${@:2}"

  if ! git -C "$SEC_STORE" diff --cached --quiet -- "${@:2}"; then
    git -C "$SEC_STORE" commit -qm "$1" -- "${@:2}"
  fi
}

# Entry helpers

parse() {
  declare -g __sec__body=
  declare -ga __sec__keys=()
  declare -ga __sec__secret=()
  declare -ga __sec__values=()

  n=0

  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))

    if [ -z "$line" ]; then
      __sec__body=$(cat)
      break
    elif [[ $line =~ ^([A-Za-z0-9_.-]+)(!?):\ ?(.*)$ ]]; then
      if [ "${BASH_REMATCH[1]}" = 'body' ]; then
        err "$1: line $n: 'body' is reserved" || return
      fi

      __sec__keys+=("${BASH_REMATCH[1]}")
      __sec__secret+=("${BASH_REMATCH[2]}")
      __sec__values+=("${BASH_REMATCH[3]}")
    else
      err "$1: line $n: expected 'key: value'" || return
    fi
  done
}

load() {
  content=$(decrypt "$SEC_STORE/${1#./}.gpg") || exit 1
  parse "$1" < <(printf '%s\n' "$content")
}

get() {
  local i # local because otherwise it messes up loops

  if [ "$1" = 'body' ]; then
    [ -n "$__sec__body" ] || return 1
    printf '%s\n' "$__sec__body"
    return
  fi

  for i in "${!__sec__keys[@]}"; do
    if [ "${__sec__keys[i]}" = "$1" ]; then
      printf '%s\n' "${__sec__values[i]}"
      return 0
    fi
  done

  return 1
}

get-primary() {
  if [ "$(get proto)" = 'ssh' ]; then
    get body
  else
    get pass
  fi
}

# Template helpers

read-template() {
  if [ -z "${1:-}" ]; then
    echo 'pass!:'
  elif [ -f "$SEC_CONFIG_HOME/protos/$1" ]; then
    cat "$SEC_CONFIG_HOME/protos/$1"
  else
    warn "no template for '$1'"
    printf 'proto: %s\npass!:\n' "$1"
  fi
}

# Query helpers

query() {
  declare -g __sec__scoped=
  declare -ga __sec__paths=()
  declare -ga __sec__filters=()
  declare -ga __sec__fields=()

  for arg; do
    case $arg in
      *=*)
        [[ $arg =~ ^([^=]*)=(.*)$ ]]
        __sec__filters+=("${BASH_REMATCH[1]%!}=${BASH_REMATCH[2]}")
        __sec__scoped=1
        ;;
      */|*[*?[]*)
        __sec__paths+=("$arg")
        __sec__scoped=1
        ;;
      */*)
        __sec__paths+=("$arg")
        ;;
      *)
        __sec__fields+=("${arg%!}")
        ;;
    esac
  done

  [ "${#__sec__paths[@]}" -gt 0 ] || __sec__scoped=1
}

glob() {
  IFS=/ read -ra p <<< "${1#./}"
  IFS=/ read -ra e <<< "$2"

  if [[ $1 == */ ]]; then
    [ "${#e[@]}" -gt "${#p[@]}" ] || return 1
  else
    [ "${#e[@]}" -eq "${#p[@]}" ] || return 1
  fi

  for i in "${!p[@]}"; do
    [[ ${e[i]} == ${p[i]} ]] || return 1
  done
}

resolve() {
  declare -gA exact=()
  declare -gA seen=()
  declare -ga all=()

  for pattern in "${__sec__paths[@]}"; do
    case $pattern in
      */|*[*?[]*) ;;
      *)
        exists "$pattern" || err "${pattern#./} is not in the store"
        exact[${pattern#./}]=1
        ;;
    esac
  done

  for pattern in "${__sec__paths[@]:-}"; do
    case $pattern in
      ''|*/|*[*?[]*) ;;
      *)
        entry=${pattern#./}

        if [ -z "${seen[$entry]:-}" ]; then
          seen[$entry]=1
          printf '%s\t1\n' "$entry"
        fi

        continue
        ;;
    esac

    [ "${#all[@]}" -gt 0 ] || mapfile -t all < <(list-store)

    for entry in "${all[@]}"; do
      [ -z "${seen[$entry]:-}" ] || continue
      [ -z "$pattern" ] || glob "$pattern" "$entry" || continue

      seen[$entry]=1
      printf '%s\t%s\n' "$entry" "${exact[$entry]:-}"
    done
  done
}

matches() {
  for filter in "${__sec__filters[@]}"; do
    if [ "${filter%%=*}" = 'body' ]; then
      [[ $__sec__body == ${filter#*=} ]] && continue
    else
      for i in "${!__sec__keys[@]}"; do
        [ "${__sec__keys[i]}" = "${filter%%=*}" ] && [[ ${__sec__values[i]} == ${filter#*=} ]] && continue 2
      done
    fi

    if [ -n "${2:-}" ]; then
      err "$1: does not match '$filter'"
    fi

    return 1
  done

  for field in "${__sec__fields[@]}"; do
    if ! get "$field" >/dev/null; then
      if [ -n "${2:-}" ]; then
        err "$1: missing field '$field'"
      fi

      return 1
    fi
  done
}

# Index helpers

index-file() {
  name=${1#"$SEC_DATA_HOME/"}
  printf '%s/sec/%s.gpg\n' "${XDG_STATE_HOME:-$HOME/.local/state}" "${name//\//%}"
}

index-record() {
  load "$1"

  # For secrets only the key is indexed, not the value.
  for i in "${!__sec__keys[@]}"; do
    if [ -n "${__sec__secret[i]}" ]; then
      printf '%s!:\n' "${__sec__keys[i]}"
    else
      printf '%s: %s\n' "${__sec__keys[i]}" "${__sec__values[i]}"
    fi
  done

  [ -z "$__sec__body" ] || printf '\n-\n'
}

index-read() {
  declare -g __sec__indexed=

  file=$(index-file "$SEC_STORE")
  [ -f "$file" ] || return 0

  plain=$(decrypt "$file")

  {
    read -r __sec__indexed

    while IFS= read -r line; do
      if [[ $line == $'\t'* ]]; then
        __sec__index[$entry]+=${line#$'\t'}$'\n'
      else
        entry=$line
        __sec__index[$entry]=
      fi
    done
  } <<< "$plain"
}

index-write() {
  # Fully rebuilds the index from scratch.

  {
    printf '%s\n' "$1"

    for entry in "${!__sec__index[@]}"; do
      printf '%s\n' "$entry"
      [ -n "${__sec__index[$entry]}" ] || continue
      mapfile -t lines <<< "${__sec__index[$entry]%$'\n'}"
      printf '\t%s\n' "${lines[@]}"
    done
  } | encrypt "$(index-file "$SEC_STORE")"
}

index-update() {
  # Incrementally rebuilds the index based on git.

  declare -gA __sec__index=()
  declare -gA __sec__dirty=()

  [ -d "$SEC_STORE/.git" ] || return 0
  head=$(git -C "$SEC_STORE" rev-parse -q --verify HEAD) || return 0

  while IFS= read -rd '' path; do
    path=${path:3}
    [[ $path != *.gpg ]] || __sec__dirty[${path%.gpg}]=1
  done < <(git -C "$SEC_STORE" status --porcelain -z -uall --no-renames)

  if [ "${1:-}" = 'full' ]; then
    __sec__indexed=
  else
    index-read
  fi

  declare -gA changed=()

  if [ -n "$__sec__indexed" ] && git -C "$SEC_STORE" cat-file -e "$__sec__indexed^{commit}" 2>/dev/null; then
    while IFS= read -rd '' path; do
      changed[${path%.gpg}]=1
    done < <(git -C "$SEC_STORE" diff -z --name-only --no-renames "$__sec__indexed" HEAD -- '*.gpg')
  else
    __sec__index=()
  fi

  while IFS= read -r entry; do
    [ -n "${__sec__index[$entry]+set}" ] || changed[$entry]=1
  done < <(list-store)

  [ "${#changed[@]}" -lt 10 ] || echo "${0##*/}: indexing ${#changed[@]} entries" >&2

  for entry in "${!changed[@]}"; do
    if [ -n "${__sec__dirty[$entry]:-}" ] || ! exists "$entry"; then
      unset '__sec__index[$entry]'
    else
      record=$(index-record "$entry")
      __sec__index[$entry]=${record:+$record$'\n'}
    fi
  done

  if [ "${#changed[@]}" -gt 0 ] || [ "$__sec__indexed" != "$head" ]; then
    index-write "$head"
  fi
}

peek() {
  [ -n "${__sec__index[$1]+set}" ] && [ -z "${__sec__dirty[$1]:-}" ] || return 1
  parse "$1" <<< "${__sec__index[$1]}"
}

needs-secret() {
  for name in "${__sec__fields[@]}" "${__sec__filters[@]%%=*}"; do
    if [ "$name" = 'body' ]; then
      [ -z "$__sec__body" ] || return 0
      continue
    fi

    for i in "${!__sec__keys[@]}"; do
      [ "${__sec__keys[i]}" != "$name" ] || [ -z "${__sec__secret[i]}" ] || return 0
    done
  done

  return 1
}

# Output helpers

render() {
  if [ "$2" = 0 ] && [[ $3 == otpauth://totp/* ]]; then
    printf '%s\n' "$3" | totp || err "$1: invalid otpauth URI"
  else
    printf '%s\n' "$3"
  fi
}

emit() {
  if [ "$1" = 1 ]; then
    printf '%s' "$3" | pbcopy

    (
      sleep "${SEC_CLIP_TIME:-45}"
      [ "$(pbpaste)" != "$3" ] || printf '' | pbcopy
    ) >/dev/null 2>&1 &
    disown

    echo "Copied to clipboard, clearing in ${SEC_CLIP_TIME:-45} seconds." >&2
  elif [ "$2" = 1 ]; then
    required qrencode

    printf '%s' "$3" | qrencode -t ansiutf8
  else
    printf '%s\n' "$3"
  fi
}

# Editing helpers

edit() {
  sandbox "$1"

  tmp=$(mkpriv sec)
  trap 'rm -rf "$tmp"' EXIT

  printf '%s\n' "$2" > "$tmp/entry"

  while :; do
    $EDITOR "$tmp/entry"
    parse "$1" < "$tmp/entry" && break
    prompt -y "Edit again?" || exit 1
  done

  if [ "$(< "$tmp/entry")" = "$2" ] && [ -z "${4:-}" ]; then
    err 'nothing changed, aborting'
  fi

  # Drops header fields left empty.
  awk '!body && /^[A-Za-z0-9_.-]+!?: ?$/ { next } /^$/ { body = 1 } 1' "$tmp/entry" |
    encrypt "$SEC_STORE/$1.gpg"

  commit "$3" "$1.gpg"
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  source arg

  usage() {
    echo "Usage: $(basename "$0") [opts] <path>"
    echo "       $(basename "$0") [opts] <command> [args]"
    echo
    echo "OPTIONS"
    echo "  -s, --store <name|path>   Select store (default: \$SEC_STORE or personal)."
    echo "  -c, --copy                Copy to clipboard."
    echo "  -q, --qr                  Render as QR code."
    echo "  -f, --force               Overwrite with mv and cp, don't confirm rm."
    echo "  -r, --recursive           Allow rm on directories."
    echo "  -h, --help                Show this help."
    echo
    echo "COMMANDS"
    echo "  <path>                    Print the primary secret."
    echo "  add <path> [proto]        Create an entry from the proto template in \$EDITOR."
    echo "  gen <path> [length]       Generate a pass, then continue as add."
    echo "  edit <path>               Edit an entry in \$EDITOR, validating the format."
    echo "  sync                      Pull and push every store, or only the one given with -s."
    echo "  ls [path|dir/|glob]...    List entries, the whole store by default."
    echo "  index                     Rebuild the query index used by secq."
    echo "  mv <from> <to>            Move an entry or directory."
    echo "  cp <from> <to>            Copy an entry or directory."
    echo "  rm <path>                 Remove an entry, or a directory with -r."
    echo "  init <gpg-id>...          Create a store, or reencrypt it for new ids."
    echo "  git <args>                Run git in the store."
    echo
    echo "SHELL INTEGRATION"
    echo "  completions <shell>       Print completions for sec, secq and secv (bash|zsh)."
    echo
    exit 0
  }

  cmd-show() {
    use-store "$store"

    path=${1#./}

    if exists "$path"; then
      load "$path"
      value=$(get-primary) || err "$path has no primary secret"
      emit "$copy" "$qr" "$value"
    elif [ -d "$SEC_STORE/$path" ]; then
      cmd-ls "${path%/}/"
    else
      err "$path is not in the store"
    fi
  }

  cmd-add() {
    use-store "$store"

    path=${1#./}

    if exists "$path"; then
      err "$path already exists, use 'sec edit'"
    fi

    if [ -n "${3:-}" ]; then
      edit "$path" "pass!: $3" "Add generated password for $path." 'force'
    else
      edit "$path" "$(read-template "$2")" "Add $path."
    fi
  }

  cmd-gen() {
    length=${2:-${SEC_GENERATED_LENGTH:-27}}

    if ! [[ $length =~ ^[1-9][0-9]*$ ]]; then
      err "invalid length: $length"
    fi

    # Apple-style password generation

    read -r -n "$length" password < <(LC_ALL=C tr -dc 'a-z0-9' < /dev/urandom)

    for ((i = 6; i < length - 1; i += 7)); do
      password=${password:0:i}-${password:i+1}
    done

    chars=()
    for ((i = 0; i < length; i++)); do
      [ "${password:i:1}" = '-' ] || chars+=("$i")
    done

    if [[ $password != *[0-9]* ]]; then
      i=${chars[SRANDOM % ${#chars[@]}]}
      password=${password:0:i}$((SRANDOM % 10))${password:i+1}
    fi

    letters=()
    for i in "${chars[@]}"; do
      [[ ${password:i:1} != [a-z] ]] || letters+=("$i")
    done

    if [ "${#letters[@]}" -gt 0 ]; then
      i=${letters[SRANDOM % ${#letters[@]}]}
      letter=${password:i:1}
      password=${password:0:i}${letter^^}${password:i+1}
    fi

    cmd-add "$1" '' "$password"
    [ "$copy$qr" = 00 ] || emit "$copy" "$qr" "$password"
  }

  cmd-edit() {
    use-store "$store"

    path=${1#./}

    if ! exists "$path"; then
      err "$path is not in the store"
    fi

    content=$(decrypt "$SEC_STORE/$path.gpg")
    edit "$path" "$content" "Edit $path using ${EDITOR##*/}."
  }

  cmd-sync() {
    failed=0
    dirs=("$SEC_DATA_HOME"/*/)

    if [ -n "$store" ]; then
      use-store "$store"
      dirs=("$SEC_STORE")
    elif [ -n "${SEC_STORE:-}" ]; then
      use-store
      dirs+=("$SEC_STORE")
    fi

    declare -A synced=()

    for dir in "${dirs[@]}"; do
      dir=${dir%/}
      [ -z "${synced[$dir]:-}" ] || continue
      synced[$dir]=1

      [ -d "$dir/.git" ] && [ -n "$(git -C "$dir" remote)" ] || continue

      if ! { git -C "$dir" pull -q --rebase && git -C "$dir" push -q; }; then
        warn "${dir##*/}: sync failed"
        failed=1
        continue
      fi

      use-store "$dir"
      index-update
    done

    return "$failed"
  }

  cmd-ls() {
    use-store "$store"

    args=()

    for pattern; do
      if [[ $pattern != */ ]] && [ -d "$SEC_STORE/${pattern#./}" ]; then
        pattern+=/
      fi

      args+=("$pattern")
    done

    query "${args[@]}"

    if [ "${#__sec__filters[@]}" -gt 0 ]; then
      err "ls: filters are not supported, use secq"
    fi

    if [ "${#__sec__fields[@]}" -gt 0 ]; then
      err "${__sec__fields[0]} is not in the store"
    fi

    mapfile -t entries < <(resolve); wait $!

    if [ "${#entries[@]}" -eq 0 ]; then
      err "no match"
    fi

    dim= reset=

    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
      dim=$'\e[2m' reset=$'\e[0m'
    fi

    for entry in "${entries[@]%%$'\t'*}"; do
      printf '%s%s%s%s\n' "$dim" "${entry%"${entry##*/}"}" "$reset" "${entry##*/}"
    done
  }

  cmd-index() {
    use-store "$store"

    if [ ! -d "$SEC_STORE/.git" ]; then
      err "index: $SEC_STORE is not a git repository"
    fi

    index-update full
  }

  cmd-move() {
    use-store "$store"
    sandbox "$2"
    sandbox "$3"

    from=${2#./} to=${3#./}

    if exists "$from"; then
      src=$from.gpg
    elif [ -d "$SEC_STORE/${from%/}" ]; then
      src=${from%/}
    else
      err "$from is not in the store"
    fi

    if [[ $to == */ ]] || [ -d "$SEC_STORE/$to" ]; then
      dst=${to%/}/${src##*/}
    elif [[ $src == *.gpg ]]; then
      dst=$to.gpg
    else
      dst=$to
    fi

    if [ -d "$SEC_STORE/$dst" ]; then
      err "${dst%.gpg} already exists"
    elif [ -e "$SEC_STORE/$dst" ] && [ "$force" = 0 ]; then
      err "${dst%.gpg} already exists, use -f"
    fi

    (
      cd "$SEC_STORE"
      mkdir -p "$(dirname "$dst")"

      case $1 in
        mv) mv -f "$src" "$dst" ;;
        cp) cp -Rf "$src" "$dst" ;;
      esac
    )

    if [ "$1" = 'mv' ]; then
      commit "Rename $from to $to." "$src" "$dst"
      (cd "$SEC_STORE" && try rmdir -p "$(dirname "$src")")
    else
      commit "Copy $from to $to." "$dst"
    fi
  }

  cmd-rm() {
    use-store "$store"
    sandbox "$1"

    path=${1#./}

    if exists "$path"; then
      file=$path.gpg
    elif [ -d "$SEC_STORE/${path%/}" ]; then
      [ "$recursive" = 1 ] || err "$path is a directory, use -r"
      file=${path%/}
    else
      err "$path is not in the store"
    fi

    [ "$force" = 1 ] || prompt -n "Remove $path?" || exit 1

    rm -r "$SEC_STORE/$file"
    commit "Remove $path from store." "$file"
    (cd "$SEC_STORE" && try rmdir -p "$(dirname "$file")")
  }

  cmd-init() {
    use-store "$store" create

    old=
    [ ! -f "$SEC_STORE/.gpg-id" ] || old=$(< "$SEC_STORE/.gpg-id")
    printf '%s\n' "$@" > "$SEC_STORE/.gpg-id"

    if [ ! -d "$SEC_STORE/.git" ]; then
      git -C "$SEC_STORE" init -q
      git -C "$SEC_STORE" config diff.gpg.binary true
      git -C "$SEC_STORE" config diff.gpg.textconv 'gpg -dq'
      echo '*.gpg diff=gpg' > "$SEC_STORE/.gitattributes"
    fi

    if [ -z "$old" ]; then
      commit "Initialize store for $*." .
    elif [ "$old" != "$(< "$SEC_STORE/.gpg-id")" ]; then
      mapfile -t entries < <(list-store)

      for entry in "${entries[@]}"; do
        decrypt "$SEC_STORE/$entry.gpg" | encrypt "$SEC_STORE/$entry.gpg"
      done

      commit "Reencrypt store for $*." .
    fi
  }

  # Completion

  complete-stores() {
    for f in "$SEC_DATA_HOME"/*/; do
      f=${f%/}
      printf '%s\n' "${f##*/}"
    done
  }

  complete-entries() {
    use-store "$1"

    for f in "$SEC_STORE/${3%"${3##*/}"}"*; do
      f=${f#"$SEC_STORE/"}

      if [ -d "$SEC_STORE/$f" ]; then
        printf '%s\n' "$2$f/"
      elif [[ $f == *.gpg ]]; then
        printf '%s\n' "$2${f%.gpg}"
      fi
    done
  }

  complete-protos() {
    for f in "$SEC_CONFIG_HOME"/protos/*; do
      printf '%s\n' "$1${f##*/}"
    done
  }

  cmd-complete() {
    shopt -s nullglob

    prog=${1##*/} cur=${!#} store= expect= verbatim=
    opts=(-s --store -h --help) pos=()

    case $prog in
      sec) opts+=(-c --copy -q --qr -f --force -r --recursive) ;;
      secq) opts+=(-r --raw -1 --single -c --copy -q --qr) ;;
      secv) opts+=(-f --format -n --offline) ;;
    esac

    for word in "${@:2:$#-2}"; do
      if [ -n "$expect" ]; then
        [ "$expect" != store ] || store=$word
        expect=
      elif [ -n "$verbatim" ]; then
        pos+=("$word")
      else
        case $word in
          --) verbatim=1 ;;
          --store=*) store=${word#*=} ;;
          -s|--store|-[!-]*s) expect=store ;;
          -s?*) store=${word#-s} ;;
          -f|--format|-[!-]*f) [ "$prog" != secv ] || expect=format ;;
          -*) ;;
          *)
            pos+=("$word")
            [[ $prog != sec || $word != git ]] || verbatim=1
            ;;
        esac
      fi
    done

    {
      if [ "$expect" = store ]; then
        complete-stores
      elif [ "$expect" = format ]; then
        printf '%s\n' args env export
      elif [ -z "$verbatim" ] && [[ $cur == -* ]]; then
        printf '%s\n' "${opts[@]}"
      else
        case $prog in
          sec)
            case ${pos[0]:-}:${#pos[@]} in
              :0) printf '%s\n' add gen edit sync ls index mv cp rm init git; complete-entries "$store" '' "$cur" ;;
              add:1|gen:1|edit:1|ls:*|mv:*|cp:*|rm:*) complete-entries "$store" '' "$cur" ;;
              add:2) complete-protos '' ;;
              completions:1) printf '%s\n' bash zsh ;;
            esac
            ;;

          secq)
            case $cur in
              proto=*) complete-protos proto= ;;
              *=*) ;;
              *) complete-entries "$store" '' "$cur" ;;
            esac
            ;;

          secv)
            case $cur in
              *=*:*) ;;
              *=*) complete-entries "$store" "${cur%%=*}=" "${cur#*=}" ;;
              *) [ "${#pos[@]}" -gt 0 ] || complete-entries "$store" '' "$cur" ;;
            esac
            ;;
        esac
      fi
    } | cur=$cur awk 'index($0, ENVIRON["cur"]) == 1'
  }

  cmd-completions() {
    case ${1:-} in
      zsh)
        cat <<-'EOF'
					_sec() {
					  local -a c
					  c=(${(f)"$(command sec complete "${(@)words[1,CURRENT]}" 2>/dev/null)"})
					  compadd -S '' -- ${(M)c:#*/}
					  compadd -- ${c:#*/}
					}
					compdef _sec sec secq secv
				EOF
        ;;

      bash)
        # Splits COMP_LINE itself, as COMP_WORDS breaks VAR=path:field apart on = and :.
        cat <<-'EOF'
					_sec() {
					  local line=${COMP_LINE:0:COMP_POINT} words cur
					  read -ra words <<< "$line"
					  [[ $line != *[[:space:]] ]] || words+=('')
					  cur=${words[${#words[@]}-1]}
					  mapfile -t COMPREPLY < <(command sec complete "${words[@]}" 2>/dev/null)
					  COMPREPLY=("${COMPREPLY[@]#"${cur%"${cur##*[=:]}"}"}")
					  [[ ${#COMPREPLY[@]} -ne 1 || ${COMPREPLY[0]} != */ ]] || compopt -o nospace
					}
					complete -F _sec sec secq secv
				EOF
        ;;

      *) err "completions: unknown shell '${1:-}' (bash|zsh)" ;;
    esac
  }

  case ${1:-} in
    complete) shift; cmd-complete "$@"; exit ;;
    completions) shift; cmd-completions "$@"; exit ;;
  esac

  arg --define store --short s --default ''
  arg --define copy --short c --flag
  arg --define qr --short q --flag
  arg --define force --short f --flag
  arg --define recursive --short r --flag
  arg --define help --short h --flag

  # Git gets its arguments verbatim,
  # only options before the command are parsed.

  for ((i = 1; i <= $#; i++)); do
    case ${!i} in
      -s|--store) i=$((i + 1)) ;;
      -*) ;;
      git)
        arg --parse "${@:1:i-1}"
        [ "$help" = 0 ] || usage
        shift "$i"
        use-store "$store"
        exec git -C "$SEC_STORE" "$@"
        ;;
      *) break ;;
    esac
  done

  arg --parse "$@"

  [ "$help" = 0 ] || usage

  if [ "$copy" = 1 ] && [ "$qr" = 1 ]; then
    err '-c and -q are mutually exclusive'
  fi

  case ${argv[0]:-} in
    '')
      usage
      ;;

    add)
      if [ "$argc" -lt 2 ]; then
        err 'add: missing path'
      fi

      if [ "$argc" -gt 3 ]; then
        err "add: unexpected argument '${argv[3]}'"
      fi

      cmd-add "${argv[1]}" "${argv[2]:-}"
      ;;

    gen)
      if [ "$argc" -lt 2 ]; then
        err 'gen: missing path'
      fi

      if [ "$argc" -gt 3 ]; then
        err "gen: unexpected argument '${argv[3]}'"
      fi

      cmd-gen "${argv[1]}" "${argv[2]:-}"
      ;;

    edit)
      if [ "$argc" -lt 2 ]; then
        err 'edit: missing path'
      fi

      if [ "$argc" -gt 2 ]; then
        err "edit: unexpected argument '${argv[2]}'"
      fi

      cmd-edit "${argv[1]}"
      ;;

    sync)
      if [ "$argc" -gt 1 ]; then
        err "sync: unexpected argument '${argv[1]}'"
      fi

      cmd-sync
      ;;

    ls)
      cmd-ls "${argv[@]:1}"
      ;;

    index)
      if [ "$argc" -gt 1 ]; then
        err "index: unexpected argument '${argv[1]}'"
      fi

      cmd-index
      ;;

    mv|cp)
      if [ "$argc" -lt 3 ]; then
        err "${argv[0]}: missing path"
      fi

      if [ "$argc" -gt 3 ]; then
        err "${argv[0]}: unexpected argument '${argv[3]}'"
      fi

      cmd-move "${argv[@]}"
      ;;

    rm)
      if [ "$argc" -lt 2 ]; then
        err 'rm: missing path'
      fi

      if [ "$argc" -gt 2 ]; then
        err "rm: unexpected argument '${argv[2]}'"
      fi

      cmd-rm "${argv[1]}"
      ;;

    init)
      if [ "$argc" -lt 2 ]; then
        err 'init: missing gpg id'
      fi

      cmd-init "${argv[@]:1}"
      ;;

    */*)
      if [ "$argc" -ne 1 ]; then
        err "unexpected argument '${argv[1]}'"
      fi

      cmd-show "${argv[0]}"
      ;;

    *)
      err "unknown command '${argv[0]}'"
      ;;
  esac
fi