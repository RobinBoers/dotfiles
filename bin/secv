#!/usr/bin/env bash
# Environment secret injection for sec, an amazing password manager, written in Bash.

set -euo pipefail

source arg
source sec

usage() {
  echo "Usage: $(basename "$0") [opts] [path] VAR[=[path][:field]]..."
  echo
  echo "OPTIONS"
  echo "  -s, --store <name|path>   Select store (default: \$SEC_STORE or personal)."
  echo "  -f, --format <format>     Output format: args (default), env or export."
  echo "  -n, --offline             Skip pulling the store before reading."
  echo "  -h, --help                Show this help."
  echo
  echo "VARIABLES"
  echo "  VAR                       Field 'var' (lowercased) of the default path."
  echo "  VAR=:field                Field of the default path."
  echo "  VAR=path                  Primary secret of path."
  echo "  VAR=path:field            Field of path."
  echo "  VAR=a{ref}b               Template interpolating path, path:field or :field."
  echo
  echo "The store is pulled at most once every two minutes."
  echo
  exit 0
}

# Docker rejects the unknown flag, which aborts a 'set -e' payload.
trap '[ $? -eq 0 ] || echo --imagine-not-supporting-this-flag' EXIT

arg --define store --short s --default ''
arg --define format --short f --default 'args'
arg --define offline --short n --flag
arg --define help --short h --flag
arg --parse "$@"

[ "$help" = 0 ] || usage

case $format in
  args|env|export) ;;
  *) err "unknown format '$format'" ;;
esac

set -- "${argv[@]}"
default=

if [ "$#" -gt 0 ] && [[ $1 == */* && $1 != *=* ]]; then
  default=${1#./}
  shift
fi

if [ "$#" -eq 0 ]; then
  err 'missing variables'
fi

use-store "$store"

recent=$(find "$SEC_STORE/.git/FETCH_HEAD" -mmin -2 2>/dev/null || true)

if [ "$offline" = 0 ] && [ -z "$recent" ] && [ -n "$(swallow git -C "$SEC_STORE" remote)" ]; then
  if ! git -C "$SEC_STORE" pull -q --ff-only >&2; then
    warn 'pull failed, using the local copy'
  fi
fi

# resolve NAME REF DEFAULT: print the secret REF (path, path:field or :field) points to.
resolve() {
  path=${2%%:*}
  field=

  if [[ $2 == *:* ]]; then
    field=${2#*:}
  fi

  path=${path:-$3}
  path=${path#./}

  if [ -z "$path" ]; then
    err "$1: no path given and no default path"
  fi

  if ! exists "$path"; then
    err "$path is not in the store"
  fi

  load "$path"

  if [ -n "$field" ]; then
    get "$field" || err "$path: missing field '$field'"
  else
    get-primary || err "$path has no primary secret"
  fi
}

# expand NAME TEMPLATE DEFAULT: print TEMPLATE with each {ref} resolved.
expand() {
  rest=$2
  result=

  while [[ $rest =~ \{([^{}]*)\} ]]; do
    result+=${rest%%"${BASH_REMATCH[0]}"*}
    result+=$(resolve "$1" "${BASH_REMATCH[1]}" "$3")
    rest=${rest#*"${BASH_REMATCH[0]}"}
  done

  printf '%s' "$result$rest"
}

unsafe='[[:space:]*?[]'
out=

for spec; do
  name=${spec%%=*}

  if ! [[ $name =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    err "invalid variable name '$name'"
  fi

  if [[ $spec != *=* ]]; then
    ref=:${name,,}
  else
    ref=${spec#*=}
  fi

  if [[ $ref == *{* ]]; then
    value=$(expand "$name" "$ref" "$default")
  else
    value=$(resolve "$name" "$ref" "$default")
  fi

  if [ "$format" != 'export' ] && [[ $value == *$'\n'* ]]; then
    err "$name: multiline values only work with --format export"
  fi

  if [ "$format" = 'args' ] && [[ $value =~ $unsafe ]]; then
    err "$name: whitespace and glob characters only work with --format env or export"
  fi

  case $format in
    args) out+="-e $name=$value"$'\n' ;;
    env) out+="$name=$value"$'\n' ;;
    export) out+="export $name='${value//\'/\'\\\'\'}'"$'\n' ;;
  esac
done

printf '%s' "$out"