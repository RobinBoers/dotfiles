#!/usr/bin/env bash
# Environment secret injection for sec, an amazing password manager, written in Bash.

set -euo pipefail

source arg
source sec

usage() {
  echo "Usage: $(basename "$0") [opts] [path] VAR[=[path][:field]]... | @path"
  echo
  echo "OPTIONS"
  echo "  -s, --store <name|path>   Select store (default: \$SEC_STORE or personal)."
  echo "  -f, --format <format>     Output format: args, env or export."
  echo "  -n, --offline             Skip pulling the store before reading."
  echo "  -h, --help                Show this help."
  echo
  echo "VARIABLES"
  echo "  VAR                       Field 'var' (lowercased) of the default path."
  echo "  VAR=:field                Field of the default path."
  echo "  VAR=path                  Primary secret of path."
  echo "  VAR=path:field            Field of path."
  echo "  VAR=a{ref}b               Template interpolating path, path:field or :field."
  echo "  @path                     Read template lines from disk."
  echo
  exit 0
}

# Docker rejects the unknown flag, which aborts a 'set -e' payload.
trap '[ $? -eq 0 ] || echo --imagine-not-supporting-this-flag' EXIT

arg --define store --short s --default ''
arg --define format --short f --default ''
arg --define offline --short n --flag
arg --define help --short h --flag
arg --parse "$@"

[ "$help" = 0 ] || usage

set -- "${argv[@]}"
default=

if [ -z "$format" ]; then
  format=args

  for spec; do
    if [[ $spec == @* ]]; then
      format=export
    fi
  done
fi

case $format in
  args|env|export) ;;
  *) err "unknown format '$format'" ;;
esac

if [ "$#" -gt 0 ] && [[ $1 == */* && $1 != *=* && $1 != @* ]]; then
  default=${1#./}
  shift
fi

if [ "$#" -eq 0 ]; then
  err 'missing variables'
fi

use-store "$store"

recent=$(find "$SEC_STORE/.git/FETCH_HEAD" -mmin -2 2>/dev/null || true)

if [ "$offline" = 0 ] && [ -z "$recent" ] && [ -n "$(swallow git -C "$SEC_STORE" remote)" ]; then
  if ! git -C "$SEC_STORE" pull -q --ff-only >&2; then
    warn 'pull failed, using the local copy'
  fi
fi

resolve() {
  path=${2%%:*}
  field=

  if [[ $2 == *:* ]]; then
    field=${2#*:}
  fi

  path=${path:-$3}
  path=${path#./}

  if [ -z "$path" ]; then
    err "$1: no path given and no default path"
  fi

  if ! exists "$path"; then
    err "$path is not in the store"
  fi

  load "$path"

  if [ -n "$field" ]; then
    get "$field" || err "$path: missing field '$field'"
  else
    get-primary || err "$path has no primary secret"
  fi
}

expand() {
  rest=$2
  result=

  while [[ $rest =~ \{([^{}]*)\} ]]; do
    result+=${rest%%"${BASH_REMATCH[0]}"*}
    result+=$(resolve "$1" "${BASH_REMATCH[1]}" "$3")
    rest=${rest#*"${BASH_REMATCH[0]}"}
  done

  printf '%s' "$result$rest"
}

unsafe='[[:space:]*?[]'
out=

validate() {
  if ! [[ $1 =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
    err "invalid variable name '$1'"
  fi
}

emit() {
  if [ "$format" != 'export' ] && [[ $2 == *$'\n'* ]]; then
    err "$1: multiline values only work with --format export"
  fi

  if [ "$format" = 'args' ] && [[ $2 =~ $unsafe ]]; then
    err "$1: whitespace and glob characters only work with --format env or export"
  fi

  case $format in
    args) out+="-e $1=$2"$'\n' ;;
    env) out+="$1=$2"$'\n' ;;
    export) out+="export $1='${2//\'/\'\\\'\'}'"$'\n' ;;
  esac
}

for spec; do
  if [[ $spec == @* ]]; then
    # The shell can't glob a word starting with @, so expand it here.
    IFS= files=(${spec#@})

    for file in "${files[@]}"; do
      n=0

      [ -f "$file" ] || err "no such file: $file"

      while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))

        if [[ $line =~ ^[[:space:]]*(#|$) ]]; then
          continue
        fi

        if [[ $line != *=* ]]; then
          err "$file: line $n: expected VAR=template"
        fi

        name=${line%%=*}
        validate "$name"
        value=$(expand "$name" "${line#*=}" '')
        emit "$name" "$value"
      done < "$file"
    done

    continue
  fi

  name=${spec%%=*}
  validate "$name"

  if [[ $spec != *=* ]]; then
    ref=:${name,,}
  else
    ref=${spec#*=}
  fi

  if [[ $ref == *{* ]]; then
    value=$(expand "$name" "$ref" "$default")
  else
    value=$(resolve "$name" "$ref" "$default")
  fi

  emit "$name" "$value"
done

printf '%s' "$out"