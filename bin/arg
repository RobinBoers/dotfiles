#!/usr/bin/env bash

declare -ag __arg__kinds=()
declare -ag __arg__names=()
declare -ag __arg__defaults=()
declare -ag __arg__required=()

declare -ag argv=()

__arg__error() {
  echo >&2 "${0##*/}: $1"
  exit 2
}

__arg__usage() {
  echo "Usage: arg <operation> <arguments>"
  echo
  echo "OPERATIONS"
  echo "  --define <name> <options>"
  echo "  --parse <arguments>"
  echo
  echo "OPTIONS"
  echo "  --flag"
  echo "  --default <value>"
  echo "  --required"
  echo
  exit 0
}

__arg__define() {
  [ "$#" -ge 2 ] || __arg__error '--define requires a name and type'

  local name=$1
  local kind
  local default
  local required=0
  local existing

  shift

  if [[ ! $name =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]]; then
    __arg__error "invalid option name '$name'"
  fi

  case "$1" in
    --flag)
      [ "$#" -eq 1 ] || __arg__error "--flag for '$name' takes no value"
      kind=flag
      default=0
      ;;

    --default)
      [ "$#" -eq 2 ] || __arg__error "--default for '$name' requires one value"
      kind=value
      default=$2
      ;;

    --required)
      [ "$#" -eq 1 ] || __arg__error "--required for '$name' takes no value"
      kind=value
      required=1
      ;;

    *) __arg__error "unknown type '$1' for '$name'" ;;
  esac

  for existing in "${__arg__names[@]}"; do
    [ "$existing" != "$name" ] || __arg__error "option '--$name' is already defined"
  done

  __arg__kinds+=("$kind")
  __arg__names+=("$name")
  __arg__defaults+=("$default")
  __arg__required+=("$required")
}

__arg__getopt() {
  if prefix=$(swallow brew --prefix gnu-getopt); then
    PATH=$prefix/bin:$PATH
  fi

  getopt --test >/dev/null 2>&1 && status=0 || status=$?
  [ "$status" -eq 4 ] || __arg__error 'GNU getopt is required'

  getopt "$@" || exit 2
}

__arg__parse() {
  local longoptions= separator= options name value index
  local -a seen=()

  for index in "${!__arg__names[@]}"; do
    longoptions+=$separator${__arg__names[index]}
    [ "${__arg__kinds[index]}" = value ] && longoptions+=:
    separator=,
    seen[index]=0
    declare -g "${__arg__names[index]}=${__arg__defaults[index]}"
  done

  options=$(__arg__getopt --options '' --longoptions "$longoptions" --name "${0##*/}" -- "$@")
  eval set -- "$options"

  while [ "$1" != -- ]; do
    name=${1#--}
    for index in "${!__arg__names[@]}"; do
      [ "${__arg__names[index]}" = "$name" ] || continue
      if [ "${__arg__kinds[index]}" = value ]; then
        value=$2
        shift 2
      else
        value=1
        shift
      fi
      declare -g "$name=$value"
      seen[index]=1
      break
    done
  done

  shift
  argv=("$@")

  for index in "${!__arg__names[@]}"; do
    if [ "${__arg__required[index]}" -eq 1 ] && [ "${seen[index]}" -eq 0 ]; then
      __arg__error "option '--${__arg__names[index]}' is required"
    fi
  done

  __arg__kinds=()
  __arg__names=()
  __arg__defaults=()
  __arg__required=()
}

arg() {
  case "${1:-}" in
    ""|-h|--help) __arg__usage ;;
    --define) __arg__define "${@:2}" ;;
    --parse) __arg__parse "${@:2}" ;;
    *) __arg__error "unknown operation '$1'" ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  arg "$@"
fi
